---
export interface Props {
  whatsappNumber?: string
  message?: string
}
const {whatsappNumber, message} = Astro.props
const href = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message || 'Assalamualaikum, saya ingin bertanya')}`
  : '#'
---
{whatsappNumber && (
  <a
    href={href}
    target="_blank"
    rel="noopener"
    aria-label="Hubungi kami via WhatsApp"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-xl flex items-center justify-center transition-all hover:scale-110"
  >
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4C7.24 4 3.34 7.9 3.34 12.71c0 1.5.4 2.96 1.14 4.25L3.27 21l4.15-1.09a8.68 8.68 0 0 0 4.62 1.32h.01c4.81 0 8.72-3.9 8.72-8.71 0-2.33-.9-4.51-2.55-6.15Zm-5.55 13.4h-.01a7.2 7.2 0 0 1-3.68-1.01l-.26-.16-2.74.72.73-2.67-.17-.27a7.24 7.24 0 0 1-1.11-3.86c0-4 3.25-7.25 7.25-7.25a7.2 7.2 0 0 1 5.13 2.13 7.19 7.19 0 0 1 2.12 5.13c0 4-3.25 7.25-7.26 7.25Z"/></svg>
  </a>
)}
