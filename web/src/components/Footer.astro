---
import { sanityClient } from "sanity:client";

// KITA KUNCI ID-NYA AGAR TIDAK SALAH TARIK DATA LAMA
const data: any = await sanityClient.fetch(`{
  "settings": *[_type == "siteSettings" && _id == "siteSettings"][0],
  "footer": *[_type == "footerSettings" && _id == "footerSettings"][0]
}`);

const { settings, footer } = data;
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#020408] text-gray-400 pt-24 pb-8 border-t border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.02] pointer-events-none"
         style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/e/ec/World_map_blank_without_borders.svg'); background-size: cover; background-position: center;">
    </div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">

        {/* GRID UTAMA: 12 Kolom (5 - 4 - 3) Untuk Layout Premium yang Lega */}
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 mb-16">

            {/* AREA 1: Brand & Sosial Media (Lebar: 5/12) */}
            <div class="md:col-span-5 flex flex-col justify-start">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight">
                    {footer?.schoolName || 'SMA ABBS'} <span class="text-yellow-600">{footer?.schoolRegion || 'Yogyakarta'}</span>
                </h2>
                <p class="text-sm leading-relaxed text-gray-500 mb-8 max-w-sm">
                    {footer?.shortDesc || 'Mewujudkan generasi ulul albab yang berakhlak mulia, berprestasi tinggi dalam sains, dan berwawasan global.'}
                </p>

                {/* ICON SOSMED - Hanya tampil jika link-nya sudah diisi di Sanity */}
                <div class="flex flex-wrap gap-3 mt-auto pt-4">
                    {settings?.socmedIg && (
                        <a href={settings.socmedIg} target="_blank" rel="noopener" aria-label="Instagram" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-yellow-600 hover:border-yellow-600 hover:text-black transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    )}
                    {settings?.socmedTk && (
                        <a href={settings.socmedTk} target="_blank" rel="noopener" aria-label="TikTok" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-gray-100 hover:border-gray-100 hover:text-black transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>
                    )}
                    {settings?.socmedYt && (
                        <a href={settings.socmedYt} target="_blank" rel="noopener" aria-label="YouTube" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-red-600 hover:border-red-600 hover:text-white transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-youtube"></i>
                        </a>
                    )}
                    {settings?.socmedWa && (
                        <a href={settings.socmedWa} target="_blank" rel="noopener" aria-label="WhatsApp" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-green-600 hover:border-green-600 hover:text-white transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                    )}
                    {settings?.socmedFb && (
                        <a href={settings.socmedFb} target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-blue-600 hover:border-blue-600 hover:text-white transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                    )}
                    {settings?.socmedX && (
                        <a href={settings.socmedX} target="_blank" rel="noopener" aria-label="Twitter / X" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-white hover:border-white hover:text-black transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                    )}
                    {settings?.socmedThreads && (
                        <a href={settings.socmedThreads} target="_blank" rel="noopener" aria-label="Threads" class="w-10 h-10 border border-gray-800 flex items-center justify-center hover:bg-white hover:border-white hover:text-black transition duration-300 rounded-sm text-lg">
                            <i class="fa-brands fa-threads"></i>
                        </a>
                    )}
                </div>
            </div>

            {/* AREA 2: Navigasi Links (Lebar: 4/12) */}
            <div class="md:col-span-4 grid grid-cols-2 gap-8">
                <div>
                    <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-6 border-l-2 border-yellow-600 pl-3">
                        {footer?.col1Title || 'Akses Cepat'}
                    </h4>
                    <ul class="space-y-4">
                        {footer?.col1Links ? footer.col1Links.map((link: any) => (
                            <li><a href={link.url} class="text-sm hover:text-yellow-500 transition duration-300 block">{link.label}</a></li>
                        )) : (
                            <>
                                <li><a href="/" class="text-sm hover:text-yellow-500 transition block">Beranda</a></li>
                                <li><a href="/news" class="text-sm hover:text-yellow-500 transition block">Jurnal Berita</a></li>
                            </>
                        )}
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-6 border-l-2 border-yellow-600 pl-3">
                        {footer?.col2Title || 'Akademik'}
                    </h4>
                    <ul class="space-y-4">
                        {footer?.col2Links ? footer.col2Links.map((link: any) => (
                            <li><a href={link.url} class="text-sm hover:text-yellow-500 transition duration-300 block">{link.label}</a></li>
                        )) : (
                            <li><a href="/team" class="text-sm hover:text-yellow-500 transition block">Guru & Staf</a></li>
                        )}
                    </ul>
                </div>
            </div>

            {/* AREA 3: Kontak (Lebar: 3/12) */}
            <div class="md:col-span-3">
                <h4 class="text-white font-bold uppercase tracking-widest text-xs mb-6 border-l-2 border-yellow-600 pl-3">Hubungi Kami</h4>
                <ul class="space-y-5">
                    <li class="flex items-start gap-4">
                        <div class="mt-1 w-6 h-6 rounded bg-gray-900 flex items-center justify-center flex-shrink-0 text-yellow-600">
                            <i class="fa-solid fa-map-pin text-xs"></i>
                        </div>
                        <span class="text-sm leading-relaxed text-gray-400">{footer?.address || 'Wedomartani, Ngemplak, Sleman, Yogyakarta'}</span>
                    </li>
                    <li class="flex items-center gap-4">
                        <div class="w-6 h-6 rounded bg-gray-900 flex items-center justify-center flex-shrink-0 text-yellow-600">
                            <i class="fa-solid fa-phone text-xs"></i>
                        </div>
                        <span class="text-sm text-gray-400">{footer?.phone || '(0271) 7XXXXX'}</span>
                    </li>
                    <li class="flex items-center gap-4">
                        <div class="w-6 h-6 rounded bg-gray-900 flex items-center justify-center flex-shrink-0 text-yellow-600">
                            <i class="fa-solid fa-envelope text-xs"></i>
                        </div>
                        <span class="text-sm text-gray-400">{footer?.email || 'info@sma-abbs.sch.id'}</span>
                    </li>
                </ul>
            </div>

        </div>

        {/* GARIS BAWAH COPYRIGHT */}
        <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-white/5 text-xs text-gray-600">
            <p>&copy; {currentYear} {footer?.copyright || 'SMA ABBS Yogyakarta. High Performance School.'}</p>
            <div class="flex gap-6 mt-4 md:mt-0 uppercase tracking-widest text-[10px]">
                <a href="#" class="hover:text-white transition">Privacy Policy</a>
                <a href="#" class="hover:text-white transition">Terms & Condition</a>
            </div>
        </div>
    </div>
</footer>