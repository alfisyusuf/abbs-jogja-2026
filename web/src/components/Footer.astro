---
import {urlFor} from '../lib/sanity/image'
import {resolveNavHref} from '../lib/nav'

export interface Props {
  settings: any
}
const {settings} = Astro.props
const logoUrl = settings?.logo ? urlFor(settings.logo).width(96).height(96).url() : null
const quickLinks = (settings?.mainMenu || []).flatMap((item: any) => (item.children?.length ? item.children : [item]))

const socialIcons: Record<string, string> = {
  Instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  Facebook: 'M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z',
  YouTube: 'M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z',
}
---
<footer class="bg-gray-900 text-gray-300 pt-20 pb-10 border-t-4 border-abbs-blue">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-1">
            {logoUrl
              ? <img src={logoUrl} alt={`Logo ${settings?.siteTitle}`} class="w-full h-full object-contain" />
              : <div class="w-full h-full rounded-lg bg-gray-200" />}
          </div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-xl text-white leading-tight">{settings?.siteTitle}</span>
            {settings?.siteTagline && <span class="text-sm font-semibold text-abbs-blue uppercase tracking-wider">{settings.siteTagline}</span>}
          </div>
        </div>
        {settings?.footerText && <p class="text-gray-400 text-sm leading-relaxed mb-6">{settings.footerText}</p>}
        <div class="flex gap-4">
          {(settings?.socialLinks || []).map((s: any) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.platform} class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-abbs-blue hover:text-white transition-all shadow-md">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={socialIcons[s.platform] || ''}></path></svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-white font-bold text-lg mb-6">Tautan Cepat</h4>
        <ul class="space-y-3">
          {quickLinks.map((item: any) => (
            <li><a href={resolveNavHref(item)} class="text-gray-400 hover:text-abbs-blue transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              {item.label}
            </a></li>
          ))}
        </ul>
      </div>

      {settings?.ppsActive && (
        <div>
          <h4 class="text-white font-bold text-lg mb-6">Pendaftaran (PPS)</h4>
          <p class="text-gray-400 text-sm mb-5 leading-relaxed">Penerimaan Peserta Didik Baru telah dibuka. Dapatkan informasi lengkap dan rincian biaya langsung via WhatsApp.</p>
          {settings?.whatsappNumber && (
            <a href={`https://wa.me/${settings.whatsappNumber}?text=Saya%20ingin%20info%20pendaftaran%20PPS`} target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 bg-abbs-blue hover:bg-abbs-blue-dark text-white px-6 py-2.5 rounded-full text-sm font-bold transition-all shadow-md">
              Info Pendaftaran
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          )}
        </div>
      )}

      <div>
        <h4 class="text-white font-bold text-lg mb-6">Kontak Kami</h4>
        <ul class="space-y-4">
          {settings?.address && (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-abbs-blue shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <span class="text-gray-400 text-sm leading-relaxed">{settings.address}</span>
            </li>
          )}
          {settings?.phone && (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-abbs-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <a href={`tel:${settings.phone.replace(/[^0-9+]/g, '')}`} class="text-gray-400 hover:text-abbs-blue text-sm transition-colors">{settings.phone}</a>
            </li>
          )}
          {settings?.email && (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-abbs-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              <a href={`mailto:${settings.email}`} class="text-gray-400 hover:text-abbs-blue text-sm transition-colors">{settings.email}</a>
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm text-center md:text-left">{settings?.copyrightText}</p>
    </div>
  </div>
</footer>
