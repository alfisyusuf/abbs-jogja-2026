---
import {urlFor} from '../lib/sanity/image'
import {resolveNavHref} from '../lib/nav'

export interface Props {
  settings: any
}
const {settings} = Astro.props
const menu = settings?.mainMenu || []
const logoUrl = settings?.logo ? urlFor(settings.logo).width(96).height(96).url() : null
---
<nav id="site-navbar" class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-lg border-b border-gray-100 transition-shadow duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <a href="/" class="flex items-center gap-3">
        <div class="w-12 h-12 flex items-center justify-center overflow-hidden">
          {logoUrl
            ? <img src={logoUrl} alt={`Logo ${settings?.siteTitle}`} class="w-full h-full object-contain" />
            : <div class="w-12 h-12 rounded-xl bg-abbs-blue/10" />}
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-xl text-gray-900 leading-tight">{settings?.siteTitle}</span>
          {settings?.siteTagline && (
            <span class="text-sm font-semibold text-abbs-blue-dark uppercase tracking-wider">{settings.siteTagline}</span>
          )}
        </div>
      </a>

      <div class="hidden lg:flex items-center space-x-8 h-full">
        {menu.map((item: any) => (
          item.children?.length ? (
            <div class="relative group h-full flex items-center">
              <button class="text-gray-600 group-hover:text-abbs-blue-dark font-medium flex items-center gap-1 transition-colors h-full" aria-haspopup="true" aria-expanded="false">
                {item.label}
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute top-20 left-0 pt-4 w-56 hidden group-hover:block transition-all">
                <div class="bg-white shadow-lg rounded-xl overflow-hidden border border-gray-50">
                  {item.children.map((child: any) => (
                    <a href={resolveNavHref(child)} class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-abbs-blue-dark">{child.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={resolveNavHref(item)} class="text-gray-600 hover:text-abbs-blue-dark font-medium transition-colors">{item.label}</a>
          )
        ))}
      </div>

      <div class="hidden lg:flex items-center h-full">
        {settings?.navCtaUrl && (
          <a href={settings.navCtaUrl} target="_blank" rel="noopener"
             class="flex items-center gap-2 bg-abbs-blue hover:bg-abbs-blue-dark text-white px-6 py-2.5 rounded-full font-semibold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4C7.24 4 3.34 7.9 3.34 12.71c0 1.5.4 2.96 1.14 4.25L3.27 21l4.15-1.09a8.68 8.68 0 0 0 4.62 1.32h.01c4.81 0 8.72-3.9 8.72-8.71 0-2.33-.9-4.51-2.55-6.15Z"/></svg>
            {settings.navCtaLabel}
          </a>
        )}
      </div>

      <div class="lg:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-gray-600 hover:text-abbs-blue-dark focus:outline-none" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu navigasi">
          <svg id="mobile-menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu: setiap item dengan anak menjadi accordion sendiri (bisa dibuka lebih dari satu sekaligus) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 shadow-xl absolute w-full max-h-[calc(100vh-5rem)] overflow-y-auto">
    <div class="px-4 pt-2 pb-6 space-y-1">
      {menu.map((item: any) => (
        item.children?.length ? (
          <details class="group/sub rounded-lg">
            <summary class="flex items-center justify-between gap-2 px-3 py-3 text-base font-semibold text-gray-800 rounded-lg cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-gray-50">
              {item.label}
              <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-200 group-open/sub:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="pl-4 pb-2 pt-1 space-y-1 border-l-2 border-blue-50 ml-3">
              {item.children.map((child: any) => (
                <a href={resolveNavHref(child)} class="block px-3 py-2.5 text-sm font-medium text-gray-600 hover:text-abbs-blue-dark hover:bg-gray-50 rounded-lg transition-colors">{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a href={resolveNavHref(item)} class="block px-3 py-3 text-base font-semibold text-gray-800 hover:text-abbs-blue-dark hover:bg-gray-50 rounded-lg transition-colors">{item.label}</a>
        )
      ))}
      {settings?.navCtaUrl && (
        <div class="mt-4 pt-4 border-t border-gray-100">
          <a href={settings.navCtaUrl} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 bg-abbs-blue text-white px-6 py-3 rounded-xl font-semibold shadow-md">
            {settings.navCtaLabel}
          </a>
        </div>
      )}
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-navbar')
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('mobile-menu-icon-open')
  const iconClose = document.getElementById('mobile-menu-icon-close')

  // Bayangan navbar saat halaman discroll, untuk memberi kedalaman tanpa
  // mengubah warna dasar navbar.
  const onScroll = () => {
    if (!nav) return
    nav.classList.toggle('shadow-md', window.scrollY > 8)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, {passive: true})

  const closeMobileMenu = () => {
    menu?.classList.add('hidden')
    btn?.setAttribute('aria-expanded', 'false')
    iconOpen?.classList.remove('hidden')
    iconClose?.classList.add('hidden')
    // Tutup kembali semua accordion submenu saat menu utama ditutup
    menu?.querySelectorAll('details[open]').forEach((d) => d.removeAttribute('open'))
  }

  btn?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('hidden')
    menu?.classList.toggle('hidden')
    btn.setAttribute('aria-expanded', String(!!willOpen))
    iconOpen?.classList.toggle('hidden', !!willOpen)
    iconClose?.classList.toggle('hidden', !willOpen)
    if (!willOpen) closeMobileMenu()
  })

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMobileMenu())
  })
</script>