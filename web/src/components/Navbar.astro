---
import { sanityClient } from "sanity:client";

const data: any = await sanityClient.fetch(`{
  "settings": *[_type == "siteSettings" && _id == "siteSettings"][0],
  "nav": *[_type == "navbarSettings" && _id == "navbarSettings"][0]
}`);

const { settings, nav } = data;
---

<nav class="absolute top-0 left-0 w-full z-50 flex justify-between items-start">
    <div class="flex items-stretch">
        <button id="menuBtn" class="bg-white text-gray-900 px-6 py-4 flex items-center gap-3 hover:bg-gray-50 transition-all duration-200 cursor-pointer group">
            <div class="hamburger-icon flex flex-col gap-[5px] w-5">
                <span class="block h-[2px] w-full bg-gray-900 transition-all duration-300 origin-center"></span>
                <span class="block h-[2px] w-3/4 bg-gray-900 transition-all duration-300"></span>
                <span class="block h-[2px] w-full bg-gray-900 transition-all duration-300 origin-center"></span>
            </div>
            <span class="font-bold tracking-[0.15em] text-xs uppercase">{nav?.menuLabel || 'MENU'}</span>
        </button>
        <a href={nav?.ctaLink || '#'} class="bg-maroon text-white px-8 py-4 flex items-center font-bold tracking-[0.15em] text-xs uppercase hover:bg-[#1E4E7D] transition-colors duration-200">
            {nav?.ctaLabel || 'DAFTAR'}
        </a>
    </div>

    <div class="hidden md:flex items-center gap-5 px-8 py-4 text-white">
        {settings?.socmedWa && (
            <a href={settings.socmedWa} target="_blank" rel="noopener" aria-label="WhatsApp" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-whatsapp text-lg"></i></a>
        )}
        {settings?.socmedIg && (
            <a href={settings.socmedIg} target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-instagram text-lg"></i></a>
        )}
        {settings?.socmedTk && (
            <a href={settings.socmedTk} target="_blank" rel="noopener" aria-label="TikTok" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-tiktok text-lg"></i></a>
        )}
        {settings?.socmedYt && (
            <a href={settings.socmedYt} target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-youtube text-lg"></i></a>
        )}
        {settings?.socmedFb && (
            <a href={settings.socmedFb} target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-facebook-f text-lg"></i></a>
        )}
        {settings?.socmedX && (
            <a href={settings.socmedX} target="_blank" rel="noopener" aria-label="Twitter / X" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-x-twitter text-lg"></i></a>
        )}
        {settings?.socmedThreads && (
            <a href={settings.socmedThreads} target="_blank" rel="noopener" aria-label="Threads" class="hover:text-yellow-400 transition-colors duration-200 opacity-80 hover:opacity-100"><i class="fa-brands fa-threads text-lg"></i></a>
        )}
        <div class="h-4 w-px bg-white/30 mx-1"></div>
        <a href="/news" class="flex items-center gap-2 font-semibold text-xs hover:text-yellow-400 transition-colors duration-200 uppercase tracking-widest opacity-80 hover:opacity-100">
            {nav?.journalLabel || 'JURNAL'} <i class="fa-solid fa-newspaper ml-1 text-xs"></i>
        </a>
    </div>
</nav>

<div id="fullMenu" class="fixed inset-0 z-[100] pointer-events-none">
    <div id="menuBackdrop" class="absolute inset-0 bg-[#0a0a0a] opacity-0 transition-opacity duration-500"></div>

    <div id="menuPanel" class="absolute top-0 left-0 h-full w-full md:w-[55%] bg-maroon flex flex-col -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]">

        <div class="flex items-center justify-between px-10 pt-10 pb-8 border-b border-white/10">
            <span class="text-white/40 text-xs uppercase tracking-[0.3em] font-bold">Navigation</span>
            <button id="closeMenuBtn" class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-white/10 transition-all duration-200 cursor-pointer">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-10 py-8">
            <ul class="space-y-1" id="mainMenuList">
                {nav?.menuItems ? nav.menuItems.map((item: any, idx: number) => (
                    <li class="menu-item border-b border-white/10" style={`--delay: ${idx * 60}ms`}>
                        {item.submenus && item.submenus.length > 0 ? (
                            <>
                                <button
                                    class="submenu-trigger w-full flex items-center justify-between py-5 text-left group"
                                    data-target={`submenu-${idx}`}
                                    aria-expanded="false">
                                    <span class="text-2xl md:text-3xl text-white font-light group-hover:text-yellow-400 transition-colors duration-200 tracking-tight">
                                        {item.title}
                                    </span>
                                    <span class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center flex-shrink-0 ml-4 transition-all duration-300 group-hover:border-yellow-400 group-hover:bg-yellow-400/10 submenu-arrow">
                                        <i class="fa-solid fa-plus text-white/60 text-xs transition-all duration-300 group-hover:text-yellow-400"></i>
                                    </span>
                                </button>
                                <div id={`submenu-${idx}`} class="submenu-panel overflow-hidden max-h-0 transition-[max-height] duration-400 ease-in-out">
                                    <div class="pb-4 pl-4 border-l-2 border-yellow-500/50 ml-2 mb-2">
                                        {item.submenus.map((sub: any) => (
                                            <a href={sub.link}
                                               class="flex items-center gap-3 py-3 text-base text-gray-300 hover:text-white transition-colors duration-200 group/sub">
                                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500/0 group-hover/sub:bg-yellow-500 transition-all duration-200 flex-shrink-0"></span>
                                                {sub.title}
                                                <i class="fa-solid fa-arrow-right text-[10px] text-yellow-500/0 group-hover/sub:text-yellow-500 transition-all duration-200 ml-auto"></i>
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </>
                        ) : (
                            <a href={item.link}
                               class="flex items-center justify-between py-5 text-2xl md:text-3xl text-white font-light hover:text-yellow-400 transition-colors duration-200 tracking-tight group">
                                {item.title}
                                <i class="fa-solid fa-arrow-right text-sm text-white/0 group-hover:text-yellow-400/60 transition-all duration-200 ml-4"></i>
                            </a>
                        )}
                    </li>
                )) : (
                    <>
                        <li class="menu-item border-b border-white/10">
                            <a href="/" class="flex items-center py-5 text-2xl text-white font-light hover:text-yellow-400 transition-colors duration-200">Beranda</a>
                        </li>
                        <li class="menu-item border-b border-white/10">
                            <a href="/news" class="flex items-center py-5 text-2xl text-white font-light hover:text-yellow-400 transition-colors duration-200">Jurnal</a>
                        </li>
                    </>
                )}
            </ul>

            <div class="mt-10 pt-8">
                <a href={nav?.ctaLink || '#'}
                   class="inline-flex items-center gap-3 bg-yellow-500 text-[#2E6DA4] font-bold text-sm uppercase tracking-[0.15em] px-8 py-4 hover:bg-yellow-400 transition-colors duration-200">
                    {nav?.ctaLabel || 'DAFTAR SEKARANG'}
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
        </nav>

        <div class="px-10 py-8 border-t border-white/10">
            <div class="flex flex-wrap gap-4">
                {settings?.socmedIg && (
                    <a href={settings.socmedIg} target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                )}
                {settings?.socmedTk && (
                    <a href={settings.socmedTk} target="_blank" rel="noopener" aria-label="TikTok" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-tiktok"></i>
                    </a>
                )}
                {settings?.socmedYt && (
                    <a href={settings.socmedYt} target="_blank" rel="noopener" aria-label="YouTube" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-youtube"></i>
                    </a>
                )}
                {settings?.socmedWa && (
                    <a href={settings.socmedWa} target="_blank" rel="noopener" aria-label="WhatsApp" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                )}
                {settings?.socmedFb && (
                    <a href={settings.socmedFb} target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                )}
                {settings?.socmedX && (
                    <a href={settings.socmedX} target="_blank" rel="noopener" aria-label="Twitter / X" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                )}
                {settings?.socmedThreads && (
                    <a href={settings.socmedThreads} target="_blank" rel="noopener" aria-label="Threads" class="w-9 h-9 border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200 text-sm rounded-sm">
                        <i class="fa-brands fa-threads"></i>
                    </a>
                )}
            </div>
        </div>
    </div>

    <div id="menuDeco" class="absolute top-0 right-0 h-full w-[45%] hidden md:flex flex-col items-center justify-center opacity-0 transition-opacity duration-700 delay-300 pointer-events-none">
        <div class="text-[12rem] font-bold text-white/[0.03] select-none leading-none tracking-tighter">ABBS</div>
        <p class="text-white/20 text-xs uppercase tracking-[0.4em] mt-4">SMA ABBS Yogyakarta</p>
    </div>
</div>

<style>
    .menu-item {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.35s ease, transform 0.35s ease;
        transition-delay: var(--delay, 0ms);
    }
    .menu-open .menu-item {
        opacity: 1;
        transform: translateY(0);
    }
    .submenu-panel {
        transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .submenu-panel.open {
        max-height: 500px;
    }
    .submenu-trigger[aria-expanded="true"] .submenu-arrow {
        transform: rotate(45deg);
        border-color: rgba(128,0,0,0.5);
        background-color: rgba(128,0,0,0.1);
    }
    .submenu-trigger[aria-expanded="true"] .submenu-arrow i {
        color: rgb(128,0,0);
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('menuBtn');
        const closeMenuBtn = document.getElementById('closeMenuBtn');
        const fullMenu = document.getElementById('fullMenu');
        const menuPanel = document.getElementById('menuPanel');
        const menuBackdrop = document.getElementById('menuBackdrop');
        const menuDeco = document.getElementById('menuDeco');
        const mainMenuList = document.getElementById('mainMenuList');

        const openMenu = () => {
            fullMenu.classList.remove('pointer-events-none');

            // Backdrop
            menuBackdrop.classList.remove('opacity-0');
            menuBackdrop.classList.add('opacity-95');

            // Panel Slider
            menuPanel.classList.remove('-translate-x-full');
            menuPanel.classList.add('translate-x-0');

            // Deco Panel Kanan
            if (menuDeco) {
                menuDeco.classList.remove('opacity-0');
                menuDeco.classList.add('opacity-100');
            }

            mainMenuList?.classList.add('menu-open');
            document.body.style.overflow = 'hidden';
        };

        const closeMenu = () => {
            fullMenu.classList.add('pointer-events-none');

            menuBackdrop.classList.remove('opacity-95');
            menuBackdrop.classList.add('opacity-0');

            menuPanel.classList.remove('translate-x-0');
            menuPanel.classList.add('-translate-x-full');

            if (menuDeco) {
                menuDeco.classList.remove('opacity-100');
                menuDeco.classList.add('opacity-0');
            }

            mainMenuList?.classList.remove('menu-open');
            document.body.style.overflow = 'auto';
        };

        menuBtn?.addEventListener('click', openMenu);
        closeMenuBtn?.addEventListener('click', closeMenu);
        menuBackdrop?.addEventListener('click', closeMenu);

        // Submenu accordion
        document.querySelectorAll('.submenu-trigger').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                const panel = document.getElementById(targetId);
                const isOpen = btn.getAttribute('aria-expanded') === 'true';

                // Close all others
                document.querySelectorAll('.submenu-trigger').forEach(other => {
                    if (other !== btn) {
                        other.setAttribute('aria-expanded', 'false');
                        const otherId = other.getAttribute('data-target');
                        const otherPanel = document.getElementById(otherId);
                        if (otherPanel) otherPanel.classList.remove('open');
                    }
                });

                // Toggle current
                btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                if (panel) panel.classList.toggle('open', !isOpen);
            });
        });
    });
</script>