---
// src/layouts/MainLayout.astro
import '../styles/global.css'; // Wajib diimpor untuk Tailwind v4

interface Props {
  title: string;
  school?: 'yogyakarta' | 'klaten';
}

// Secara bawaan kita set ke 'yogyakarta'
const { title, school = 'yogyakarta' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme={school}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | SMA ABBS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="antialiased min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-white font-bold text-sm">ABBS</div>
          <div>
            <span class="block font-bold text-gray-900 leading-none">SMA ABBS</span>
            <span class="text-xs text-gray-500 font-medium tracking-widest uppercase">{school}</span>
          </div>
        </a>
        <nav class="hidden md:flex space-x-8 text-sm font-medium text-gray-600">
          <a href="/" class="hover:text-brand-primary transition">Home</a>
          <a href="/about" class="hover:text-brand-primary transition">About</a>
          <a href="/news" class="hover:text-brand-primary transition">News</a>
        </nav>
        <button class="bg-brand-primary text-white text-xs font-semibold px-6 py-3 rounded-full hover:bg-opacity-90 transition">
          PPS Registration
        </button>
      </div>
    </header>

    <!-- Konten Spesifik Halaman Akan Muncul Di Sini -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-brand-dark text-gray-400 py-12 text-center text-sm">
      &copy; {new Date().getFullYear()} SMA ABBS {school.toUpperCase()}. Premium Web Standards.
    </footer>
  </body>
</html>