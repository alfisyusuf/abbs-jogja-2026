---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {urlFor} from '../../lib/sanity/image'
import {getAllPostsPaged, getPostCount} from '../../lib/sanity/queries'

const PER_PAGE = 9
const total = await getPostCount()
const posts = await getAllPostsPaged(0, PER_PAGE)
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE))

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'})
}
---
<BaseLayout title="Berita & Agenda" description="Berita, agenda, dan pengumuman terbaru dari sekolah.">
  <main class="pt-24 lg:pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-14">
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-gray-900 leading-tight mb-4">Berita & Agenda</h1>
      <p class="text-lg text-gray-600 leading-relaxed">Kabar terbaru seputar kegiatan, prestasi, dan pengumuman sekolah.</p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        {posts.map((post: any) => (
          <article class="bg-white border border-gray-100 rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <a href={`/berita/${post.slug}`} class="flex flex-col h-full">
              
              {/* Gambar (Dipotong konsisten dan aman untuk Safari) */}
              <div class="relative h-56 overflow-hidden shrink-0">
                {post.mainImage && (
                  <img 
                    src={urlFor(post.mainImage).width(600).height(400).fit('crop').auto('format').url()} 
                    alt={post.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    loading="lazy" 
                  />
                )}
                {post.category && (
                  <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-4 py-1.5 rounded-full text-xs font-bold text-gray-800 shadow-sm">
                    {post.category}
                  </div>
                )}
              </div>

              {/* Konten Teks */}
              <div class="p-6 sm:p-8 flex flex-col flex-grow">
                
                {/* Tanggal dengan Ikon */}
                <div class="flex items-center gap-2 text-sm text-gray-500 mb-3 font-medium">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                </div>

                {/* Judul (Dibatasi maksimal 3 baris) */}
                <h2 class="font-display text-xl sm:text-2xl font-bold text-gray-900 mb-3 group-hover:text-abbs-blue-dark transition-colors leading-snug line-clamp-3">
                  {post.title}
                </h2>

                {/* Ringkasan (Dibatasi 3 baris, dan mendorong tombol ke bawah) */}
                <p class="text-gray-600 text-sm line-clamp-3 mb-6 leading-relaxed flex-grow">
                  {post.excerpt}
                </p>

                {/* Tombol Baca (Selalu rata bawah) */}
                <span class="text-abbs-maroon font-semibold text-sm flex items-center gap-1 mt-auto">
                  Baca Selengkapnya
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
                
              </div>
            </a>
          </article>
        ))}
      </div>

      {totalPages > 1 && (
        <div class="mt-14 flex items-center justify-center gap-2">
          <span class="w-10 h-10 rounded-full bg-abbs-blue text-white flex items-center justify-center font-bold">1</span>
          {Array.from({length: totalPages - 1}).map((_, i) => (
            <a href={`/berita/halaman/${i + 2}`} class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:border-abbs-blue hover:text-abbs-blue-dark transition-colors font-bold">{i + 2}</a>
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>
