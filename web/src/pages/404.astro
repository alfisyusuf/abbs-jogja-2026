---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Halaman Tidak Ditemukan">
  <main class="pt-40 pb-32 text-center px-4 min-h-[60vh] flex flex-col items-center justify-center">
    <p class="text-7xl md:text-8xl font-black text-[#2E6DA4]/20 mb-2 leading-none">404</p>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Halaman yang Anda cari tidak ditemukan</h1>
    <p class="text-gray-500 mb-8 max-w-md">Mungkin halamannya sudah dipindah, dihapus, atau alamatnya salah ketik.</p>
    <a href="/" class="inline-flex items-center gap-2 bg-[#2E6DA4] hover:bg-[#1E4E7D] text-white px-8 py-4 rounded-sm font-bold text-sm uppercase tracking-[0.15em] transition-all duration-300 hover:-translate-y-1">
      Kembali ke Beranda
    </a>
  </main>
</MainLayout>
