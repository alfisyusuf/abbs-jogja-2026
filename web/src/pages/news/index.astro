---
import MainLayout from '../../layouts/MainLayout.astro';
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";

// Mengambil SEMUA post, diurutkan dari yang terbaru
const data: any = await sanityClient.fetch(`{
  "settings": *[_type == "siteSettings" && _id == "siteSettings"][0],
  "posts": *[_type == "post"] | order(publishedAt desc) {
    title, slug, publishedAt, category, mainImage, tags
  }
}`);

const { settings, posts } = data;
const builder = createImageUrlBuilder(sanityClient);

function urlFor(source: any) {
  return builder.image(source).auto('format');
}

// Fungsi format tanggal untuk kotak kalender
function formatDateShort(dateString: string) {
    if (!dateString) return { day: '', month: '', year: '' };
    const date = new Date(dateString);
    const day = date.getDate();
    const month = date.toLocaleDateString('id-ID', { month: 'short' }).toUpperCase().replace('.','');
    const year = date.getFullYear();
    return { day, month, year };
}

// Pisahkan post pertama (Featured) dan sisanya
const featuredPost = posts.length > 0 ? posts[0] : null;
const regularPosts = posts.length > 1 ? posts.slice(1) : [];

// Warna per kategori
const categoryColors: Record<string, string> = {
    'Prestasi':          'bg-yellow-600',
    'Kegiatan Sekolah':  'bg-blue-700',
    'Akademik':          'bg-emerald-700',
    'Tahfidz':           'bg-purple-700',
    'Artikel':           'bg-gray-600',
    'Info PPS':          'bg-[#1E4E7D]',
};
---

<MainLayout title="Jurnal & Berita - SMA ABBS Yogyakarta" description="Kumpulan berita, prestasi, dan pembaruan terbaru dari SMA ABBS Yogyakarta.">

<header class="relative w-full overflow-hidden bg-[#05070c] pt-36 pb-20 md:pt-48 md:pb-28">
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-size: 200px;"></div>
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#2E6DA4]/[0.08] rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-yellow-500/[0.04] rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container mx-auto px-6 md:px-16 relative z-10 text-center">
        <div class="inline-flex items-center gap-3 mb-6 reveal reveal-up">
            <div class="w-8 h-[2px] bg-yellow-500"></div>
            <span class="text-yellow-500 text-[10px] font-bold tracking-[0.4em] uppercase">Journal & Updates</span>
            <div class="w-8 h-[2px] bg-yellow-500"></div>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-light text-white leading-tight mb-6 reveal reveal-up" style="--reveal-delay: 100ms">
            Berita <span class="font-black text-white">Terkini</span>
        </h1>
        
        <p class="text-white/50 text-sm md:text-base max-w-2xl mx-auto font-light leading-relaxed reveal reveal-up" style="--reveal-delay: 200ms">
            Ikuti perjalanan, prestasi, dan setiap momen berharga dari ekosistem pendidikan SMA ABBS Yogyakarta.
        </p>
    </div>
</header>

<div class="bg-[#fafaf9] relative pb-24">
    <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, #60A0D0 30%, #C9A227 70%, transparent);"></div>

    {featuredPost && (
    <section class="container mx-auto px-6 md:px-16 -mt-12 relative z-20 mb-20">
        <a href={`/news/${featuredPost.slug.current}`} class="group block reveal reveal-up">
            <div class="grid grid-cols-1 lg:grid-cols-12 bg-white shadow-2xl rounded-sm overflow-hidden">
                
                <div class="lg:col-span-7 relative overflow-hidden" style="aspect-ratio: 16/10;">
                    <img 
                        src={featuredPost.mainImage ? urlFor(featuredPost.mainImage).width(1200).height(750).url() : "https://placehold.co/1200x750/f3f4f6/ccc?text=Featured"} 
                        alt={featuredPost.title}
                        class="w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105">
                    
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
                    
                    <div class="absolute top-0 left-0 bg-[#2E6DA4] text-white px-5 py-3 text-center shadow-lg">
                        <span class="block text-2xl font-black leading-none mb-0.5">{formatDateShort(featuredPost.publishedAt).day}</span>
                        <span class="block text-[10px] font-bold tracking-widest uppercase opacity-80">{formatDateShort(featuredPost.publishedAt).month}</span>
                    </div>

                    <div class="absolute bottom-4 left-4">
                        <span class={`${categoryColors[featuredPost.category] || 'bg-[#2E6DA4]'} text-white text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 shadow-lg`}>
                            {featuredPost.category || 'Berita'}
                        </span>
                    </div>
                </div>

                <div class="lg:col-span-5 p-8 md:p-12 flex flex-col justify-center relative bg-white">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                        <span class="text-[9px] font-bold text-gray-400 uppercase tracking-[0.3em]">Artikel Utama</span>
                    </div>

                    <h2 class="text-2xl md:text-3xl lg:text-4xl text-gray-900 font-bold leading-snug group-hover:text-[#2E6DA4] transition-colors duration-300 mb-6">
                        {featuredPost.title}
                    </h2>
                    
                    <p class="text-gray-500 text-sm leading-relaxed line-clamp-3 mb-8 font-light">
                        {/* Jika ingin mengambil teks singkat dari blok body, bisa dilakukan. Tapi untuk amannya kita arahkan pembaca klik */}
                        Klik untuk membaca selengkapnya mengenai liputan dan informasi mendetail dari artikel utama ini.
                    </p>

                    <div class="mt-auto flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 group-hover:text-[#2E6DA4] transition-colors">
                        <div class="w-8 h-[2px] bg-gray-200 group-hover:bg-[#2E6DA4] transition-colors duration-300"></div>
                        Baca Artikel
                        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform duration-300"></i>
                    </div>
                </div>

            </div>
        </a>
    </section>
    )}

    {regularPosts.length > 0 && (
    <section class="container mx-auto px-6 md:px-16 pt-10">
        <div class="flex items-center gap-4 mb-10 reveal reveal-left">
            <div class="w-6 h-px bg-gray-300"></div>
            <span class="text-[10px] font-bold text-gray-500 tracking-[0.4em] uppercase">Berita Lainnya</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-12">
            {regularPosts.map((post: any, pi: number) => (
                <a href={`/news/${post.slug.current}`} class="group cursor-pointer block reveal reveal-up" style={`--reveal-delay: ${(pi % 3) * 120}ms`}>
                    <div class="relative overflow-hidden bg-gray-100 mb-5 rounded-sm shadow-sm group-hover:shadow-xl transition-all duration-300" style="aspect-ratio: 16/10;">
                        <img 
                            src={post.mainImage ? urlFor(post.mainImage).width(700).height(437).url() : "https://placehold.co/700x437/f3f4f6/ccc?text=ABBS"} 
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        
                        <div class="absolute top-0 left-0 bg-[#2E6DA4] text-white font-bold px-3 py-2 text-center leading-none shadow-md">
                            <span class="block text-lg font-black mb-0.5">{formatDateShort(post.publishedAt).day}</span>
                            <span class="block text-[9px] tracking-widest uppercase opacity-70">{formatDateShort(post.publishedAt).month}</span>
                        </div>

                        <div class="absolute inset-0 bg-[#2E6DA4]/0 group-hover:bg-[#2E6DA4]/10 transition-colors duration-500"></div>
                    </div>

                    <div class="px-1 flex flex-col h-full">
                        <span class={`${categoryColors[post.category] ? `text-${categoryColors[post.category].replace('bg-', '')}` : 'text-[#2E6DA4]'} text-[9px] font-bold uppercase tracking-[0.3em] mb-2.5 block`}>
                            {post.category || 'Berita'}
                        </span>
                        
                        <h3 class="text-lg md:text-xl text-gray-900 font-bold leading-snug group-hover:text-[#2E6DA4] transition-colors duration-200 line-clamp-3 mb-4">
                            {post.title}
                        </h3>

                        <div class="mt-auto flex items-center gap-2 text-[10px] text-gray-400 uppercase tracking-widest pt-2">
                            <div class="w-4 h-px bg-gray-300 group-hover:bg-[#2E6DA4] transition-colors"></div>
                            <span class="group-hover:text-[#2E6DA4] transition-colors font-semibold">Baca Selengkapnya</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>
    )}

    {posts.length === 0 && (
        <div class="text-center py-20">
            <i class="fa-regular fa-folder-open text-6xl text-gray-300 mb-4"></i>
            <p class="text-gray-500 font-light">Belum ada berita yang dipublikasikan saat ini.</p>
        </div>
    )}
</div>

</MainLayout>

<style>
/* ─── Scroll Reveal Animations ────────────────────────────── */
.reveal {
    opacity: 0;
    will-change: opacity, transform;
    transition:
        opacity 0.75s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.75s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
}

.reveal-up    { transform: translateY(36px); }
.reveal-left  { transform: translateX(-28px); }

.reveal.in-view {
    opacity: 1;
    transform: none;
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    /* ═══════════════════════════════════════════════════════════
       SCROLL REVEAL (IntersectionObserver)
       ═══════════════════════════════════════════════════════════ */
    if ('IntersectionObserver' in window) {
        const revealObs = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    revealObs.unobserve(entry.target); 
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });

        document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
    } else {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('in-view'));
    }
});
</script>
