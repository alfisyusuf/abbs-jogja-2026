---
import MainLayout from '../../layouts/MainLayout.astro';
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";
import { PortableText } from "astro-portabletext";
import PortableTextImage from '../../components/PortableTextImage.astro';

// 1. STATIC PATHS
export async function getStaticPaths() {
    const posts = await sanityClient.fetch(`*[_type == "post"]{ "params": { "slug": slug.current } }`);
    return posts;
}

// 2. FETCH ARTIKEL + 3 ARTIKEL TERKAIT
const { slug } = Astro.params;
const data = await sanityClient.fetch(`{
    "post": *[_type == "post" && slug.current == $slug][0]{
        title, publishedAt, category, tags, mainImage, body
    },
    "related": *[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0..2] {
        title, slug, publishedAt, category, mainImage
    }
}`, { slug });

const { post, related } = data;
const builder = createImageUrlBuilder(sanityClient);

function urlFor(source: any) {
    return builder.image(source).auto('format');
}

function formatDate(dateString: string) {
    if (!dateString) return '';
    const date = new Date(dateString);
    return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
}

function formatDateShort(dateString: string) {
    if (!dateString) return { day: '', month: '', year: '' };
    const date = new Date(dateString);
    const day = date.getDate();
    const month = date.toLocaleDateString('id-ID', { month: 'short' }).toUpperCase().replace('.','');
    const year = date.getFullYear();
    return { day, month, year };
}

// Estimasi waktu baca
function estimateReadTime(body: any[]): number {
    if (!body) return 1;
    const text = body
        .filter((b: any) => b._type === 'block')
        .flatMap((b: any) => b.children || [])
        .map((c: any) => c.text || '')
        .join(' ');
    const words = text.split(/\s+/).filter(Boolean).length;
    return Math.max(1, Math.ceil(words / 200));
}

const readTime = estimateReadTime(post?.body || []);
const dateFormatted = formatDate(post?.publishedAt);
const dateShort = formatDateShort(post?.publishedAt);

const categoryColors: Record<string, string> = {
    'Prestasi':          'bg-yellow-600',
    'Kegiatan Sekolah':  'bg-blue-700',
    'Akademik':          'bg-emerald-700',
    'Tahfidz':           'bg-purple-700',
    'Artikel':           'bg-gray-600',
    'Info PPS':          'bg-[#800000]',
};
const catColor = categoryColors[post?.category] || 'bg-[#2E6DA4]';
---

<MainLayout 
    title={`${post?.title || 'Berita'} - SMA ABBS Yogyakarta`} 
    description={post?.title}
    image={post?.mainImage ? urlFor(post.mainImage).width(1200).height(630).url() : undefined}>

<div id="readingProgress" 
     class="fixed top-0 left-0 z-[60] h-[3px] w-0 transition-none"
     style="background: linear-gradient(90deg, #800000, #60A0D0, #800000); background-size: 200% 100%;"></div>

<header class="relative w-full overflow-hidden bg-[#05070c]" style="min-height: 75vh;">

    <img 
        src={post?.mainImage 
            ? urlFor(post.mainImage).width(1920).height(1080).url() 
            : "https://placehold.co/1920x1080/111827/333?text=SMA+ABBS"} 
        alt={post?.title} 
        class="absolute inset-0 w-full h-full object-cover z-0 hero-cover-img">

    <div class="absolute inset-0 z-10" style="background: linear-gradient(180deg, rgba(5,7,12,0.6) 0%, rgba(5,7,12,0.15) 35%, rgba(5,7,12,0.9) 75%, rgba(5,7,12,1) 100%);"></div>
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 70% 50%, transparent 50%, rgba(5,7,12,0.5) 100%);"></div>

    <div class="absolute top-0 left-0 w-full z-30 pt-20 md:pt-24 pb-4">
        <div class="container mx-auto px-5 md:px-16">
            <div class="flex items-center gap-2 md:gap-3 text-white/50 text-[10px] md:text-xs">
                <a href="/news" class="flex items-center gap-1.5 md:gap-2 hover:text-white transition-colors uppercase tracking-[0.1em] md:tracking-[0.2em] flex-shrink-0">
                    <i class="fa-solid fa-arrow-left text-[9px] md:text-[10px]"></i>
                    Kembali
                </a>
                <div class="w-px h-3 bg-white/20"></div>
                <span class="hidden md:inline shrink-0 text-white/30">Berita & Artikel</span>
                <div class="hidden md:block w-px h-3 bg-white/20"></div>
                <span class="truncate max-w-[150px] md:max-w-xs text-white/70">{post?.title}</span>
            </div>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full z-20 pb-14 pt-32">
        <div class="container mx-auto px-5 md:px-16">
            <div class="max-w-4xl">
                <div class="flex flex-wrap items-center gap-3 mb-5 md:mb-6 hero-meta">
                    <span class={`${catColor} text-white text-[9px] font-black uppercase tracking-[0.3em] px-3 py-1.5 rounded-sm`}>
                        {post?.category || 'Berita'}
                    </span>
                    <div class="w-px h-4 bg-white/20"></div>
                    <div class="flex items-center gap-1.5 text-white/50 text-[10px] md:text-xs">
                        <i class="fa-regular fa-calendar"></i>
                        <span>{dateFormatted}</span>
                    </div>
                    <div class="w-px h-4 bg-white/20 hidden sm:block"></div>
                    <div class="hidden sm:flex items-center gap-1.5 text-white/50 text-xs">
                        <i class="fa-regular fa-clock"></i>
                        <span>{readTime} menit baca</span>
                    </div>
                </div>

                <h1 class="text-3xl md:text-5xl lg:text-[3.5rem] font-light text-white leading-[1.15] mb-6 hero-title">
                    {post?.title}
                </h1>
                <div class="w-16 h-[3px] bg-yellow-500 hero-bar"></div>
            </div>
        </div>
    </div>

    {dateShort.day && (
        <div class="absolute right-8 md:right-16 bottom-14 z-20 text-right hidden md:flex flex-col items-end gap-0.5 hero-datestamp">
            <span class="text-5xl font-black text-white/[0.07] leading-none">{dateShort.day}</span>
            <span class="text-[9px] font-bold text-white/20 uppercase tracking-[0.4em]">{dateShort.month} {dateShort.year}</span>
        </div>
    )}
</header>

<div class="bg-white relative">
    <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, #60A0D0 30%, #800000 70%, transparent);"></div>

    <div class="container mx-auto px-5 md:px-6 relative z-10">
        <div class="flex gap-0 lg:gap-16 xl:gap-20 justify-center">

            <aside class="hidden lg:flex flex-col items-center gap-5 sticky top-28 self-start pt-16 w-12 flex-shrink-0">
                <span class="text-[8px] font-bold text-gray-300 uppercase tracking-[0.35em] rotate-90 whitespace-nowrap mb-2">Bagikan</span>
                <div class="w-px h-8 bg-gray-200"></div>
                <a id="shareWa" href="#" target="_blank" class="share-btn w-10 h-10 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-green-500 hover:text-white hover:border-green-500 transition-all rounded-sm"><i class="fa-brands fa-whatsapp text-sm"></i></a>
                <a id="shareFb" href="#" target="_blank" class="share-btn w-10 h-10 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white hover:border-blue-600 transition-all rounded-sm"><i class="fa-brands fa-facebook-f text-sm"></i></a>
                <a id="shareX" href="#" target="_blank" class="share-btn w-10 h-10 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-black hover:text-white hover:border-black transition-all rounded-sm"><i class="fa-brands fa-x-twitter text-sm"></i></a>
                <button id="copyLink" class="share-btn w-10 h-10 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-[#2E6DA4] hover:text-white hover:border-[#2E6DA4] transition-all rounded-sm"><i class="fa-solid fa-link text-xs"></i></button>
                <div class="w-px h-8 bg-gray-200 mt-2"></div>
                <button id="scrollTop" class="w-10 h-10 border border-gray-200 flex items-center justify-center text-gray-300 hover:bg-gray-900 hover:text-white transition-all rounded-sm mt-4"><i class="fa-solid fa-chevron-up text-xs"></i></button>
            </aside>

            <article id="articleBody" class="w-full max-w-3xl py-12 md:py-20">
                {post?.body ? (
                    <div class="editorial-content">
                        {/* PENYUNTIKAN KOMPONEN GAMBAR DI SINI */}
                        <PortableText 
                            value={post.body} 
                            components={{ type: { image: PortableTextImage } }} 
                        />
                    </div>
                ) : (
                    <p class="text-gray-400 italic">Konten artikel belum tersedia.</p>
                )}

                {/* Tags */}
                {post?.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap items-center gap-2 mt-12 md:mt-14 pt-8 md:pt-10 border-t border-gray-100">
                    <span class="text-[9px] font-bold text-gray-300 uppercase tracking-[0.3em] mr-1">Tags</span>
                    {post.tags.map((tag: string) => (
                        <span class="text-[10px] font-medium text-gray-500 bg-gray-50 border border-gray-100 px-3 py-1.5 hover:border-[#2E6DA4]/30 hover:text-[#2E6DA4] rounded-sm transition-all cursor-default">
                            #{tag}
                        </span>
                    ))}
                </div>
                )}

                {/* Mobile share row */}
                <div class="flex items-center gap-3 mt-8 pt-8 border-t border-gray-100 lg:hidden">
                    <span class="text-[9px] font-bold text-gray-300 uppercase tracking-[0.3em]">Bagikan</span>
                    <div class="w-px h-4 bg-gray-200"></div>
                    <a id="shareWaMobile" href="#" target="_blank" class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-green-500 hover:text-white transition-all rounded-sm"><i class="fa-brands fa-whatsapp text-sm"></i></a>
                    <a id="shareFbMobile" href="#" target="_blank" class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white transition-all rounded-sm"><i class="fa-brands fa-facebook-f text-sm"></i></a>
                    <a id="shareXMobile" href="#" target="_blank" class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-black hover:text-white transition-all rounded-sm"><i class="fa-brands fa-x-twitter text-sm"></i></a>
                    <button id="copyLinkMobile" class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-[#2E6DA4] hover:text-white transition-all rounded-sm"><i class="fa-solid fa-link text-xs"></i></button>
                </div>
                <div id="copyToast" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 bg-gray-900 text-white text-xs px-5 py-3 rounded-sm shadow-2xl flex items-center gap-2 opacity-0 translate-y-4 transition-all duration-300 pointer-events-none">
                    <i class="fa-solid fa-check text-yellow-400 text-xs"></i> Tautan disalin
                </div>
            </article>

            <aside class="hidden xl:block w-56 flex-shrink-0 pt-14">
                <div class="sticky top-28">
                    <div class="border border-gray-100 p-5 mb-6 rounded-sm">
                        <div class="text-[9px] font-bold text-gray-300 uppercase tracking-[0.35em] mb-4">Tentang Artikel</div>
                        <div class="space-y-3">
                            <div>
                                <p class="text-[9px] text-gray-400 uppercase tracking-widest mb-1">Kategori</p>
                                <span class={`${catColor} text-white text-[9px] font-bold uppercase tracking-wider px-2 py-1 rounded-sm`}>{post?.category}</span>
                            </div>
                            <div>
                                <p class="text-[9px] text-gray-400 uppercase tracking-widest mb-1">Tanggal</p>
                                <p class="text-sm text-gray-700 font-medium">{dateFormatted}</p>
                            </div>
                            <div>
                                <p class="text-[9px] text-gray-400 uppercase tracking-widest mb-1">Waktu Baca</p>
                                <p class="text-sm text-gray-700 font-medium flex items-center gap-1.5">
                                    <i class="fa-regular fa-clock text-[#2E6DA4] text-xs"></i> {readTime} menit
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="border border-gray-100 p-5 rounded-sm">
                        <div class="text-[9px] font-bold text-gray-300 uppercase tracking-[0.35em] mb-3">Progress</div>
                        <div class="w-full h-1 bg-gray-100 rounded-full overflow-hidden">
                            <div id="sidebarProgress" class="h-full bg-gradient-to-r from-[#2E6DA4] to-yellow-500 rounded-full transition-all duration-150" style="width: 0%"></div>
                        </div>
                        <p id="sidebarProgressPct" class="text-[9px] text-gray-300 mt-2 font-mono">0%</p>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

{related && related.length > 0 && (
<section class="bg-[#fafaf9] py-16 md:py-20 border-t border-gray-100">
    <div class="container mx-auto px-5 md:px-16">
        <div class="flex items-end justify-between mb-8 md:mb-10">
            <div>
                <div class="flex items-center gap-3 mb-2 md:mb-3">
                    <div class="w-6 h-px bg-[#2E6DA4]/50"></div>
                    <span class="text-[9px] font-bold text-[#2E6DA4]/60 tracking-[0.4em] uppercase">Baca Juga</span>
                </div>
                <h2 class="text-2xl md:text-3xl font-light text-gray-900">
                    Artikel <span class="font-black text-[#2E6DA4]">Lainnya</span>
                </h2>
            </div>
            <a href="/news" class="hidden md:inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-gray-400 hover:text-[#2E6DA4] transition-colors duration-200 border-b border-gray-200 pb-1 hover:border-[#2E6DA4]">
                Semua Berita <i class="fa-solid fa-arrow-right text-[9px]"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((rel: any, ri: number) => {
                const relCatColor = categoryColors[rel.category] || 'bg-[#2E6DA4]';
                return (
                <a href={`/news/${rel.slug.current}`} class="group block reveal-related rounded-md overflow-hidden bg-white shadow-sm hover:shadow-xl transition-shadow duration-300" style={`animation-delay: ${ri * 100}ms`}>
                    <div class="relative overflow-hidden bg-gray-100" style="aspect-ratio: 16/10;">
                        <img 
                            src={rel.mainImage ? urlFor(rel.mainImage).width(600).height(375).url() : "https://placehold.co/600x375/f3f4f6/ccc?text=ABBS"}
                            alt={rel.title}
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.05]">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500"></div>
                        <div class="absolute top-3 left-3">
                            <span class={`${relCatColor} text-white text-[9px] font-bold uppercase tracking-wider px-2 py-1 rounded-sm shadow-sm`}>
                                {rel.category}
                            </span>
                        </div>
                    </div>
                    <div class="p-5 border border-t-0 border-gray-100 h-full flex flex-col">
                        <h3 class="text-base font-bold text-gray-900 leading-snug group-hover:text-[#2E6DA4] transition-colors duration-200 line-clamp-2 mb-4">
                            {rel.title}
                        </h3>
                        <div class="mt-auto flex items-center gap-2 text-[9px] text-gray-400 uppercase tracking-widest pt-2 border-t border-gray-50">
                            <i class="fa-regular fa-calendar text-[10px]"></i>
                            <span>{formatDate(rel.publishedAt)}</span>
                        </div>
                    </div>
                </a>
            )})}
        </div>
    </div>
</section>
)}

<div class="bg-[#05070c] py-10 md:py-12 border-t border-white/10">
    <div class="container mx-auto px-5 md:px-16 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 md:gap-6">
        <div class="text-left w-full md:w-auto">
            <p class="text-white/30 text-[10px] uppercase tracking-[0.4em] mb-1.5 md:mb-1">SMA ABBS Yogyakarta</p>
            <h3 class="text-white/90 text-lg md:text-xl font-light">Terima kasih sudah membaca.</h3>
        </div>
        
        <div class="flex flex-row w-full md:w-auto gap-3">
            <a href="/news" 
               class="flex-1 md:flex-none justify-center inline-flex items-center gap-2 border border-white/20 text-white/70 hover:border-white/50 hover:text-white text-[10px] md:text-xs uppercase tracking-[0.1em] md:tracking-[0.2em] font-bold px-4 md:px-6 py-3.5 md:py-3 transition-all duration-200 rounded-sm">
                <i class="fa-solid fa-newspaper text-[10px]"></i>
                <span class="whitespace-nowrap">Semua Berita</span>
            </a>
            <a href="/" 
               class="flex-1 md:flex-none justify-center inline-flex items-center gap-2 bg-[#2E6DA4] text-white text-[10px] md:text-xs uppercase tracking-[0.1em] md:tracking-[0.2em] font-bold px-4 md:px-6 py-3.5 md:py-3 hover:bg-[#3A7FB8] transition-colors duration-200 rounded-sm">
                <i class="fa-solid fa-house text-[10px]"></i>
                Beranda
            </a>
        </div>
    </div>
</div>

</MainLayout>

<style is:global>
/* ─── Hero animations ─────────────────────────────────── */
@keyframes heroCoverIn {
    from { transform: scale(1.06); filter: blur(4px); opacity: 0.7; }
    to   { transform: scale(1);    filter: blur(0);   opacity: 1; }
}
.hero-cover-img { animation: heroCoverIn 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

@keyframes heroUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
}
.hero-meta      { animation: heroUp 0.7s ease forwards 0.5s; opacity: 0; }
.hero-title     { animation: heroUp 0.8s ease forwards 0.7s; opacity: 0; }
.hero-bar       { animation: heroUp 0.6s ease forwards 1.0s; opacity: 0; }
.hero-datestamp { animation: heroUp 0.6s ease forwards 1.1s; opacity: 0; }

.reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2,0.8,0.2,1);
    transition-delay: var(--reveal-delay, 0ms);
}
.reveal.in-view { opacity: 1; transform: none; }

@keyframes relatedIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}
.reveal-related {
    opacity: 0;
    animation: relatedIn 0.6s ease forwards;
    animation-play-state: paused;
}
.reveal-related.visible { animation-play-state: running; }

/* ═══════════════════════════════════════════════════════
   EDITORIAL RICH TEXT (Dengan Penyesuaian Mobile)
   ═══════════════════════════════════════════════════════ */
.editorial-content {
    color: #374151;
    font-size: 1rem; /* Base font sedikit dikecilkan di mobile */
    line-height: 1.8;
    font-weight: 300;
}
@media (min-width: 768px) {
    .editorial-content { font-size: 1.125rem; line-height: 1.85; }
}

/* ── Dropcap ── */
.editorial-content > div > p:first-of-type::first-letter,
.editorial-content > p:first-of-type::first-letter {
    font-size: 4rem;
    font-weight: 900;
    color: #2E6DA4;
    float: left;
    line-height: 0.8;
    padding-right: 0.15em;
    padding-top: 0.1em;
    font-family: Georgia, serif;
    letter-spacing: -2px;
}
@media (min-width: 768px) {
    .editorial-content > p:first-of-type::first-letter { font-size: 5rem; }
}

.editorial-content p {
    margin-bottom: 1.5rem;
    color: #4B5563;
}

/* ── PERBAIKAN #2: Headings (H2) ── */
.editorial-content h2 {
    display: flex;
    align-items: center; /* Sejajarkan garis dan teks */
    font-size: 1.5rem;   /* Ukuran mobile lebih wajar */
    font-weight: 700;    /* Sesuai dengan screenshot (Bold) */
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.35;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #F3F4F6;
    letter-spacing: -0.01em;
}
@media (min-width: 768px) {
    .editorial-content h2 {
        font-size: 1.875rem; 
        margin-top: 3.5rem;
        margin-bottom: 1.25rem;
    }
}
/* Garis aksen merah diubah pendekatannya agar anti-error */
.editorial-content h2::before {
    content: '';
    display: block;
    width: 4px;
    height: 1em; /* Tinggi relatif terhadap besar font */
    background: #2E6DA4;
    margin-right: 0.5em;
    border-radius: 2px;
    flex-shrink: 0; /* Mencegah garis gepeng */
}

.editorial-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1F2937;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.35;
}
@media (min-width: 768px) { .editorial-content h3 { font-size: 1.375rem; } }

.editorial-content h4 {
    font-size: 0.875rem;
    font-weight: 800;
    color: #2E6DA4;
    margin-top: 2rem;
    margin-bottom: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
}

/* ── Blockquote (Kutipan Besar) ── */
.editorial-content blockquote {
    position: relative;
    font-size: 1.125rem;
    font-style: normal;
    font-weight: 300;
    color: #111827;
    margin: 2rem 0;
    padding: 1.25rem 1rem 1.25rem 2.5rem; /* Tambah padding kiri agar tanda petik aman */
    background: linear-gradient(135deg, rgba(128,0,0,0.08) 0%, rgba(46,109,164,0.02) 100%);
    border-left: 4px solid #60A0D0;
    line-height: 1.6;
    border-radius: 0 4px 4px 0;
}
@media (min-width: 768px) {
    .editorial-content blockquote {
        font-size: 1.3125rem;
        padding: 1.5rem 1.75rem 1.5rem 3rem;
        margin: 2.5rem 0;
    }
}
.editorial-content blockquote::before {
    content: '\201C';
    position: absolute;
    top: 0.1rem;
    left: 0.5rem; /* Menempel ke kiri */
    font-size: 4rem;
    font-family: Georgia, serif;
    color: rgba(128,0,0,0.35);
    line-height: 1;
    pointer-events: none;
}

.editorial-content a {
    color: #2E6DA4;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(46,109,164,0.35);
    font-weight: 500;
    transition: all 0.2s ease;
}
.editorial-content a:hover {
    text-decoration-color: #2E6DA4;
    background: rgba(46,109,164,0.06);
    padding: 0 2px;
    border-radius: 2px;
}

.editorial-content strong {
    font-weight: 700;
    color: #111827;
}

/* ── Bullet list ── */
.editorial-content ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 2rem;
}
.editorial-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: #4B5563;
}
.editorial-content ul li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: #60A0D0;
    border-radius: 1px;
    transform: rotate(45deg);
}

/* ── PERBAIKAN #3: Ordered list (Penomoran) ── */
.editorial-content ol {
    padding-left: 0; /* Reset */
    margin-bottom: 2rem;
    counter-reset: item;
    list-style: none;
}
.editorial-content ol li {
    counter-increment: item;
    position: relative;
    /* Beri ruang mutlak untuk angka agar teks panjang aman jatuh di baris baru */
    padding-left: 2.2rem; 
    margin-bottom: 1rem;
    color: #4B5563;
}
@media (min-width: 768px) {
    .editorial-content ol li { padding-left: 2.5rem; }
}
/* Posisi angka kini solid di pojok kiri atas baris teks */
.editorial-content ol li::before {
    content: counter(item);
    position: absolute;
    left: 0;
    top: 0.15rem; 
    font-size: 0.75rem;
    font-weight: 800;
    color: #2E6DA4;
    background: rgba(46,109,164,0.08);
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 4px; /* Sudut lebih modern */
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

/* ── Images & Table ── */
.editorial-content figure,
.editorial-content img { margin: 2rem 0 0.5rem; }
.editorial-content img {
    width: 100%; height: auto; display: block; border-radius: 4px;
    box-shadow: 0 8px 30px -10px rgba(0,0,0,0.15);
}
.editorial-content figure figcaption,
.editorial-content [data-sanity-caption] {
    font-size: 0.8125rem; color: #9CA3AF; text-align: center; font-style: italic;
    margin-top: 0.625rem; margin-bottom: 2rem; padding: 0 1rem;
}
.editorial-content table {
    width: 100%; border-collapse: collapse; margin: 2.5rem 0; font-size: 0.875rem;
}
@media (min-width: 768px) { .editorial-content table { font-size: 0.9375rem; } }
.editorial-content thead { background: #2E6DA4; color: white; }
.editorial-content thead th {
    padding: 0.75rem 1rem; text-align: left; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
}
.editorial-content tbody tr { border-bottom: 1px solid #F3F4F6; }
.editorial-content tbody tr:nth-child(even) { background: #FAFAF9; }
.editorial-content td { padding: 0.75rem 1rem; color: #4B5563; vertical-align: top; }
.editorial-content hr {
    border: none; height: 1px;
    background: linear-gradient(90deg, transparent, #E5E7EB 20%, #E5E7EB 80%, transparent);
    margin: 3rem 0;
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

    const progressBar     = document.getElementById('readingProgress');
    const sidebarProg     = document.getElementById('sidebarProgress');
    const sidebarProgPct  = document.getElementById('sidebarProgressPct');
    const articleBody     = document.getElementById('articleBody');

    const updateProgress = () => {
        if (!articleBody || !progressBar) return;
        const rect   = articleBody.getBoundingClientRect();
        const total  = articleBody.offsetHeight - window.innerHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct    = total > 0 ? Math.min(100, Math.round((scrolled / total) * 100)) : 0;
        
        progressBar.style.width = pct + '%';
        if (sidebarProg)    sidebarProg.style.width = pct + '%';
        if (sidebarProgPct) sidebarProgPct.textContent = pct + '%';
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    document.getElementById('scrollTop')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    const url   = encodeURIComponent(window.location.href);
    const title = encodeURIComponent(document.title);

    const setShare = (id, href) => {
        const el = document.getElementById(id);
        if (el) el.href = href;
    };

    setShare('shareWa',       `https://wa.me/?text=${title}%20${url}`);
    setShare('shareFb',       `https://www.facebook.com/sharer/sharer.php?u=${url}`);
    setShare('shareX',        `https://x.com/intent/tweet?text=${title}&url=${url}`);
    setShare('shareWaMobile', `https://wa.me/?text=${title}%20${url}`);
    setShare('shareFbMobile', `https://www.facebook.com/sharer/sharer.php?u=${url}`);
    setShare('shareXMobile',  `https://x.com/intent/tweet?text=${title}&url=${url}`);

    const showToast = () => {
        const t = document.getElementById('copyToast');
        if (!t) return;
        t.classList.remove('opacity-0', 'translate-y-4');
        t.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
            t.classList.add('opacity-0', 'translate-y-4');
            t.classList.remove('opacity-100', 'translate-y-0');
        }, 2500);
    };

    const copyAction = () => {
        navigator.clipboard.writeText(window.location.href).then(showToast);
    };

    document.getElementById('copyLink')?.addEventListener('click', copyAction);
    document.getElementById('copyLinkMobile')?.addEventListener('click', copyAction);

    if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    obs.unobserve(e.target);
                }
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal-related').forEach(el => obs.observe(el));
    } else {
        document.querySelectorAll('.reveal-related').forEach(el => el.classList.add('visible'));
    }
});
</script>
