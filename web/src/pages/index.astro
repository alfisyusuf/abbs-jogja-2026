<style>
/* ─── Marquee ───────────────────────────────────────────── */
@keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
@keyframes scroll-prestasi { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.logo-scroll-container { width: 100%; overflow: hidden; }
.logo-scroll-wrapper { display: flex; width: max-content; animation: scroll 40s linear infinite; }
.logo-scroll-wrapper:hover { animation-play-state: paused; }
.achievements-scroll-container { width: 100%; overflow: hidden; }
.prestasi-scroll-wrapper { display: flex; width: max-content; animation: scroll-prestasi 65s linear infinite; }
.achievements-scroll-container:hover .prestasi-scroll-wrapper { animation-play-state: paused; }

/* ─── Hero ───────────────────────────────────────────────── */
.hero-outline-text { -webkit-text-stroke: 2px rgba(255,255,255,0.7); color: transparent; }
@media (min-width: 768px) { .hero-outline-text { -webkit-text-stroke: 3px rgba(255,255,255,0.6); } }

.ppdb-glass {
    background: rgba(0,0,0,0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255,255,255,0.06);
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}
.hero-overline { animation: fadeUp 0.8s ease forwards 0.4s; }
.hero-title    { animation: fadeUp 0.9s ease forwards 0.7s; }
.hero-play     { animation: fadeUp 0.8s ease forwards 1.1s; }
.hero-logo     { animation: fadeUp 0.8s ease forwards 0.2s; opacity: 0; }

.testi-slide { transition: opacity 0.6s ease; }
.testi-slide.opacity-0 { pointer-events: none; }
.testi-dot { display: inline-block; }

/* ─── Loading screen ─────────────────────────────────────── */
@keyframes loaderRingSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}
.loader-ring { animation: loaderRingSpin 1.8s linear infinite; }

@keyframes loaderBarPulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.6; }
}

/* Loader exit animation */
#pageLoader.loader-exit {
    animation: loaderExit 0.7s cubic-bezier(0.76, 0, 0.24, 1) forwards;
}
@keyframes loaderExit {
    0%   { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.04); pointer-events: none; }
}

/* ─── Scroll Reveal ──────────────────────────────────────── */
.reveal {
    opacity: 0;
    will-change: opacity, transform;
    transition:
        opacity 0.75s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.75s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
}

/* Variants */
.reveal-up    { transform: translateY(36px); }
.reveal-left  { transform: translateX(-28px); }
.reveal-right { transform: translateX(28px); }
.reveal-scale { transform: scale(0.94); }

/* When in view */
.reveal.in-view {
    opacity: 1;
    transform: none;
}

/* ── Pulsing "live" red dot ───────────────────────── */
@keyframes videoPulse {
    0%, 100% { transform: scale(1);   opacity: 0.5; }
    50%       { transform: scale(2.2); opacity: 0; }
}
.video-pulse-ring {
    animation: videoPulse 2s ease-out infinite;
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

    /* ═══════════════════════════════════════════════
       LOADING SCREEN
    ═══════════════════════════════════════════════ */
    const loader    = document.getElementById('pageLoader');
    const loaderBar = document.getElementById('loaderBar');
    const loaderPct = document.getElementById('loaderPct');

    if (loader && loaderBar) {
        let progress = 0;
        const duration = 1800; // ms total
        const steps    = 60;
        const interval = duration / steps;

        const ease = t => 1 - Math.pow(1 - t, 3);

        const tick = setInterval(() => {
            progress++;
            const pct = Math.round(ease(progress / steps) * 100);
            loaderBar.style.width = pct + '%';
            if (loaderPct) loaderPct.textContent = pct + '%';

            if (progress >= steps) {
                clearInterval(tick);
                setTimeout(() => {
                    loader.classList.add('loader-exit');
                    loader.addEventListener('animationend', () => {
                        loader.style.display = 'none';
                        document.body.style.overflow = '';
                    }, { once: true });
                }, 250);
            }
        }, interval);

        document.body.style.overflow = 'hidden';
    }

    /* ═══════════════════════════════════════════════
       HERO IMAGE zoom-out
    ═══════════════════════════════════════════════ */
    const heroImg = document.querySelector('.hero-img');
    if (heroImg) {
        setTimeout(() => { heroImg.style.transform = 'scale(1)'; }, 100);
    }

    /* ═══════════════════════════════════════════════
       CLOSE PPDB PANEL
    ═══════════════════════════════════════════════ */
    const closePpdbBtn = document.getElementById('closePpdbBtn');
    const ppdbFloatBox = document.getElementById('ppdbFloatBox');
    if (closePpdbBtn && ppdbFloatBox) {
        closePpdbBtn.addEventListener('click', () => {
            ppdbFloatBox.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
        });
    }

    /* ═══════════════════════════════════════════════
       SCROLL REVEAL
    ═══════════════════════════════════════════════ */
    if ('IntersectionObserver' in window) {
        const revealObs = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    revealObs.unobserve(entry.target); 
                }
            });
        }, {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
        });

        document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
    } else {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('in-view'));
    }

    /* ═══════════════════════════════════════════════
       TESTIMONI SLIDER
    ═══════════════════════════════════════════════ */
    const slides  = document.querySelectorAll('.testi-slide');
    const prevBtn = document.getElementById('prevTesti');
    const nextBtn = document.getElementById('nextTesti');
    const dots    = document.querySelectorAll('.testi-dot');
    const counter = document.getElementById('testiCounter');
    const total   = slides.length;

    if (total > 1) {
        let cur = 0, iv;

        const updateCounter = () => {
            if (counter) counter.textContent = `${String(cur+1).padStart(2,'0')} / ${String(total).padStart(2,'0')}`;
        };

        const go = (idx) => {
            if (idx >= total) idx = 0;
            if (idx < 0)      idx = total - 1;
            cur = idx;

            slides.forEach((s, i) => {
                const on = i === cur;
                s.classList.toggle('opacity-100', on);
                s.classList.toggle('visible',     on);
                s.classList.toggle('relative',    on);
                s.classList.toggle('opacity-0',  !on);
                s.classList.toggle('invisible',  !on);
                s.classList.toggle('absolute',   !on);
            });

            dots.forEach((d, i) => {
                const on = i === cur;
                d.classList.toggle('w-7',           on);
                d.classList.toggle('h-[3px]',       on);
                d.classList.toggle('bg-yellow-500', on);
                d.classList.toggle('w-[3px]',      !on);
                d.classList.toggle('bg-white/20',  !on);
            });

            updateCounter();
        };

        const reset = () => { clearInterval(iv); iv = setInterval(() => go(cur + 1), 6000); };

        prevBtn?.addEventListener('click', () => { go(cur - 1); reset(); });
        nextBtn?.addEventListener('click', () => { go(cur + 1); reset(); });
        dots.forEach((d, i) => d.addEventListener('click', () => { go(i); reset(); }));
        reset();
    }

});
</script>

