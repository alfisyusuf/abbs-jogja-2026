---
import MainLayout from '../layouts/MainLayout.astro';
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";
import { PortableText } from "astro-portabletext";
import PortableTextImage from '../components/PortableTextImage.astro'; // <--- IMPORT KOMPONEN GAMBAR

export async function getStaticPaths() {
    const pages = await sanityClient.fetch(`*[_type == "page"]{ "params": { "slug": slug.current } }`);
    return pages;
}

const { slug } = Astro.params;
const page = await sanityClient.fetch(`*[_type == "page" && slug.current == $slug][0]{
    title, heroImage, body
}`, { slug });

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source: any) {
    return builder.image(source).auto('format');
}

function estimateReadTime(body: any[]): number {
    if (!body) return 1;
    const text = body
        .filter((b: any) => b._type === 'block')
        .flatMap((b: any) => b.children || [])
        .map((c: any) => c.text || '')
        .join(' ');
    const words = text.split(/\s+/).filter(Boolean).length;
    return Math.max(1, Math.ceil(words / 200));
}

const readTime = estimateReadTime(page?.body || []);
---

<MainLayout 
    title={`${page?.title || 'Halaman'} - SMA ABBS Yogyakarta`} 
    description={page?.title}
    image={page?.heroImage ? urlFor(page.heroImage).width(1200).height(630).url() : undefined}>

<div id="readingProgress" 
     class="fixed top-0 left-0 z-[60] h-[3px] w-0 transition-none"
     style="background: linear-gradient(90deg, #800000 0%, #60A0D0 50%, #800000 100%); background-size: 200% 100%;">
</div>

<header class="relative w-full overflow-hidden bg-[#05070c]" style="min-height: 62vh;">

    <img 
        src={page?.heroImage 
            ? urlFor(page.heroImage).width(1920).height(1080).url() 
            : "https://placehold.co/1920x1080/111827/222?text=SMA+ABBS"} 
        alt={page?.title} 
        class="absolute inset-0 w-full h-full object-cover z-0 hero-cover-img">

    <div class="absolute inset-0 z-10" style="background: linear-gradient(180deg, rgba(5,7,12,0.55) 0%, rgba(5,7,12,0.1) 35%, rgba(5,7,12,0.88) 72%, rgba(5,7,12,1) 100%);"></div>
    <div class="absolute inset-0 z-10" style="background: radial-gradient(ellipse at 65% 50%, transparent 45%, rgba(5,7,12,0.45) 100%);"></div>

    <div class="absolute top-0 left-0 w-full z-30 pt-20 md:pt-24 pb-4">
        <div class="container mx-auto px-6 md:px-16">
            <nav class="flex items-center gap-2 md:gap-3 text-white/40 text-[10px] md:text-[11px]">
                <a href="/" class="flex items-center gap-1.5 hover:text-white/80 transition-colors duration-200 uppercase tracking-[0.15em] md:tracking-[0.2em] flex-shrink-0 group">
                    <i class="fa-solid fa-house text-[9px] group-hover:scale-110 transition-transform duration-200"></i>
                    Beranda
                </a>
                <i class="fa-solid fa-chevron-right text-[8px] text-white/20"></i>
                <span class="truncate max-w-[180px] md:max-w-sm text-white/55 uppercase tracking-widest">{page?.title}</span>
            </nav>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full z-20 pb-12 md:pb-16">
        <div class="container mx-auto px-6 md:px-16">
            <div class="max-w-3xl">
                <div class="flex items-center gap-3 mb-5 hero-meta">
                    <div class="w-6 h-[2px] bg-yellow-500/80"></div>
                    <span class="text-yellow-400/90 text-[9px] font-black uppercase tracking-[0.4em]">
                        SMA ABBS Yogyakarta
                    </span>
                </div>
                <h1 class="text-3xl md:text-5xl lg:text-[3.25rem] font-light text-white leading-[1.18] mb-7 hero-title">
                    {page?.title}
                </h1>
                <div class="flex items-center gap-4 hero-bar">
                    <div class="w-12 h-[2px] bg-[#2E6DA4]"></div>
                    <div class="flex items-center gap-1.5 text-white/35 text-[10px] tracking-[0.15em]">
                        <i class="fa-regular fa-clock"></i>
                        <span>{readTime} menit baca</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="h-px w-full" style="background: linear-gradient(90deg, transparent 0%, #60A0D0 30%, #800000 70%, transparent 100%);"></div>

<div class="bg-white relative">
    <div class="container mx-auto px-6 md:px-16 relative z-10">
        <div class="flex justify-center gap-8 xl:gap-14">

            <aside class="hidden lg:flex flex-col items-center sticky self-start top-32 pt-20 flex-shrink-0" style="width: 44px;">
                <p class="text-[8px] font-black text-gray-300 uppercase mb-3"
                   style="writing-mode: vertical-rl; letter-spacing: 0.4em; transform: rotate(180deg);">
                    Bagikan
                </p>
                <div class="w-px h-6 mb-3" style="background: #e5e7eb;"></div>
                <div class="flex flex-col gap-2.5">
                    <a id="shareWa" href="#" target="_blank" rel="noopener"
                       class="w-11 h-11 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-green-500 hover:border-green-500 hover:text-white transition-all duration-200 rounded-sm"
                       title="WhatsApp">
                        <i class="fa-brands fa-whatsapp text-sm"></i>
                    </a>
                    <a id="shareFb" href="#" target="_blank" rel="noopener"
                       class="w-11 h-11 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-all duration-200 rounded-sm"
                       title="Facebook">
                        <i class="fa-brands fa-facebook-f text-sm"></i>
                    </a>
                    <a id="shareX" href="#" target="_blank" rel="noopener"
                       class="w-11 h-11 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-gray-900 hover:border-gray-900 hover:text-white transition-all duration-200 rounded-sm"
                       title="X / Twitter">
                        <i class="fa-brands fa-x-twitter text-sm"></i>
                    </a>
                    <button id="copyLink"
                       class="w-11 h-11 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-[#2E6DA4] hover:border-[#2E6DA4] hover:text-white transition-all duration-200 rounded-sm"
                       title="Salin tautan">
                        <i class="fa-solid fa-link text-xs"></i>
                    </button>
                </div>
                <div class="w-px h-8 mt-4 mb-4" style="background: #e5e7eb;"></div>
                <button id="scrollTop"
                   class="w-11 h-11 border border-gray-200 flex items-center justify-center text-gray-300 hover:bg-gray-900 hover:border-gray-900 hover:text-white transition-all duration-200 rounded-sm opacity-0"
                   id-title="Kembali ke atas"
                   style="transform: translateY(8px); transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s, border-color 0.2s, color 0.2s;">
                    <i class="fa-solid fa-chevron-up text-xs"></i>
                </button>
            </aside>

            <article id="articleBody" class="w-full max-w-2xl py-14 md:py-20 min-w-0">

                {page?.body ? (
                    <div class="editorial-content">
                        {/* PENYUNTIKAN KOMPONEN GAMBAR DI SINI */}
                        <PortableText 
                            value={page.body} 
                            components={{ type: { image: PortableTextImage } }} 
                        />
                    </div>
                ) : (
                    <div class="py-24 flex flex-col items-center text-center">
                        <div class="w-16 h-16 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center mb-5">
                            <i class="fa-regular fa-file-lines text-2xl text-gray-300"></i>
                        </div>
                        <p class="text-gray-400 text-sm font-light mb-2">Konten halaman sedang dalam penyusunan.</p>
                        <p class="text-gray-300 text-xs tracking-widest uppercase">Silakan kembali lagi nanti</p>
                    </div>
                )}

                <div class="mt-20 pt-10 border-t border-gray-100">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">

                        <div class="flex items-center gap-3">
                            <span class="text-[9px] font-black text-gray-300 uppercase tracking-[0.35em] flex-shrink-0">Bagikan</span>
                            <div class="w-px h-4 flex-shrink-0" style="background: #e5e7eb;"></div>
                            <div class="flex gap-2">
                                <a id="shareWaMobile" href="#" target="_blank" rel="noopener"
                                   class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-green-500 hover:border-green-500 hover:text-white transition-all duration-200 rounded-sm lg:hidden">
                                    <i class="fa-brands fa-whatsapp text-sm"></i>
                                </a>
                                <a id="shareFbMobile" href="#" target="_blank" rel="noopener"
                                   class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition-all duration-200 rounded-sm lg:hidden">
                                    <i class="fa-brands fa-facebook-f text-sm"></i>
                                </a>
                                <a id="shareXMobile" href="#" target="_blank" rel="noopener"
                                   class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-gray-900 hover:border-gray-900 hover:text-white transition-all duration-200 rounded-sm lg:hidden">
                                    <i class="fa-brands fa-x-twitter text-sm"></i>
                                </a>
                                <button id="copyLinkMobile"
                                   class="w-9 h-9 border border-gray-200 flex items-center justify-center text-gray-400 hover:bg-[#2E6DA4] hover:border-[#2E6DA4] hover:text-white transition-all duration-200 rounded-sm lg:hidden">
                                    <i class="fa-solid fa-link text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <a href="/" 
                           class="inline-flex items-center gap-2 text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] hover:text-[#2E6DA4] transition-colors duration-200 group flex-shrink-0">
                            <i class="fa-solid fa-arrow-left text-[9px] group-hover:-translate-x-0.5 transition-transform duration-200"></i>
                            Kembali ke Beranda
                        </a>
                    </div>
                </div>

            </article>

            <aside class="hidden xl:flex flex-col sticky self-start top-32 pt-20 flex-shrink-0" style="width: 180px;">
                <div class="border border-gray-100 p-4 mb-4">
                    <p class="text-[8px] font-black text-gray-300 uppercase tracking-[0.35em] mb-3">Progress Baca</p>
                    <div class="w-full h-1 bg-gray-100 rounded-full overflow-hidden mb-2">
                        <div id="sidebarProgress" class="h-full rounded-full transition-all duration-200"
                             style="width: 0%; background: linear-gradient(90deg, #800000, #60A0D0);"></div>
                    </div>
                    <p id="sidebarProgressPct" class="text-[9px] text-gray-300 font-mono">0%</p>
                </div>
                <div class="border border-gray-100 p-4 mb-5">
                    <p class="text-[8px] font-black text-gray-300 uppercase tracking-[0.35em] mb-2">Waktu Baca</p>
                    <p class="text-sm text-gray-700 font-medium flex items-center gap-1.5">
                        <i class="fa-regular fa-clock text-[#2E6DA4] text-xs"></i>
                        {readTime} menit
                    </p>
                </div>
                <div class="w-full h-px mb-5" style="background: #f3f4f6;"></div>
                <a href="/" class="flex items-center gap-2 text-[9px] font-bold text-gray-400 uppercase tracking-[0.2em] hover:text-[#2E6DA4] transition-colors duration-200 group">
                    <i class="fa-solid fa-arrow-left text-[8px] group-hover:-translate-x-0.5 transition-transform duration-200"></i>
                    Beranda
                </a>
            </aside>

        </div>
    </div>
</div>

<div id="copyToast" 
     class="fixed bottom-8 left-1/2 z-[100] bg-gray-900 text-white text-xs px-5 py-3 rounded-sm shadow-2xl flex items-center gap-2.5 pointer-events-none"
     style="transform: translateX(-50%) translateY(12px); opacity: 0; transition: opacity 0.25s ease, transform 0.25s ease;">
    <i class="fa-solid fa-check text-yellow-400 text-[10px]"></i>
    <span>Tautan berhasil disalin</span>
</div>

<div class="bg-[#05070c] py-10 border-t" style="border-color: rgba(255,255,255,0.05);">
    <div class="container mx-auto px-6 md:px-16 flex flex-col md:flex-row items-center justify-between gap-5">
        <div>
            <p class="text-white/20 text-[9px] uppercase tracking-[0.45em] mb-1 font-bold">SMA ABBS Yogyakarta</p>
            <p class="text-white/35 text-sm font-light">Terima kasih sudah membaca.</p>
        </div>
        <a href="/" 
           class="inline-flex items-center gap-2.5 border text-white/50 hover:text-yellow-400 text-[10px] uppercase tracking-[0.2em] font-bold px-6 py-3 transition-all duration-200 group"
           style="border-color: rgba(255,255,255,0.1);">
            <i class="fa-solid fa-house text-[9px] group-hover:scale-110 transition-transform duration-200"></i>
            Kembali ke Beranda
        </a>
    </div>
</div>

</MainLayout>

<style is:global>

/* ═══ Hero animations ═══════════════════════════════════ */
@keyframes heroCoverIn {
    from { transform: scale(1.05); filter: blur(3px); opacity: 0.75; }
    to   { transform: scale(1);    filter: blur(0);   opacity: 1; }
}
.hero-cover-img { animation: heroCoverIn 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

@keyframes heroUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
}
.hero-meta  { animation: heroUp 0.7s ease forwards 0.45s; opacity: 0; }
.hero-title { animation: heroUp 0.8s ease forwards 0.65s; opacity: 0; }
.hero-bar   { animation: heroUp 0.6s ease forwards 0.95s; opacity: 0; }


/* ═══ Editorial Rich Text ═══════════════════════════════ */
.editorial-content {
    color: #374151;
    font-size: 1rem;
    line-height: 1.85;
    font-weight: 300;
}
@media (min-width: 768px) {
    .editorial-content { font-size: 1.0625rem; }
}

/* Dropcap */
.editorial-content > div > p:first-child::first-letter,
.editorial-content > p:first-child::first-letter {
    font-size: 4.25rem;
    font-weight: 900;
    color: #2E6DA4;
    float: left;
    line-height: 0.8;
    padding-right: 0.15em;
    padding-top: 0.08em;
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: -1px;
}
@media (min-width: 768px) {
    .editorial-content > div > p:first-child::first-letter,
    .editorial-content > p:first-child::first-letter {
        font-size: 5rem;
    }
}

/* Paragraphs */
.editorial-content p {
    margin-bottom: 1.6rem;
    color: #4B5563;
    line-height: 1.9;
}

/* H2 */
.editorial-content h2 {
    display: flex;
    align-items: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid #F3F4F6;
    letter-spacing: -0.01em;
}
@media (min-width: 768px) {
    .editorial-content h2 { font-size: 1.75rem; margin-top: 3.5rem; }
}
.editorial-content h2::before {
    content: '';
    display: block;
    width: 4px;
    min-width: 4px;
    height: 1em;
    background: #2E6DA4;
    margin-right: 0.55em;
    border-radius: 2px;
    flex-shrink: 0;
}

/* H3 */
.editorial-content h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1F2937;
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    line-height: 1.35;
}
@media (min-width: 768px) { .editorial-content h3 { font-size: 1.35rem; } }

/* H4 */
.editorial-content h4 {
    font-size: 0.8125rem;
    font-weight: 800;
    color: #2E6DA4;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
}

/* Lead */
.editorial-content [data-style="lead"],
.editorial-content .lead {
    font-size: 1.2rem;
    font-weight: 300;
    color: #374151;
    line-height: 1.75;
    margin-bottom: 2rem;
    border-left: 3px solid #60A0D0;
    padding-left: 1.25rem;
}

/* Blockquote */
.editorial-content blockquote {
    position: relative;
    font-size: 1.0625rem;
    font-style: normal;
    font-weight: 300;
    color: #111827;
    margin: 2.25rem 0;
    padding: 1.25rem 1.25rem 1.25rem 2.75rem;
    background: linear-gradient(135deg, rgba(128,0,0,0.07) 0%, rgba(46,109,164,0.02) 100%);
    border-left: 4px solid #60A0D0;
    line-height: 1.65;
    border-radius: 0 4px 4px 0;
}
@media (min-width: 768px) {
    .editorial-content blockquote {
        font-size: 1.25rem;
        padding: 1.5rem 1.75rem 1.5rem 3.25rem;
        margin: 2.75rem 0;
    }
}
.editorial-content blockquote::before {
    content: '\201C';
    position: absolute;
    top: 0.1rem;
    left: 0.6rem;
    font-size: 3.5rem;
    font-family: Georgia, serif;
    color: rgba(128,0,0,0.4);
    line-height: 1;
    pointer-events: none;
}
.editorial-content blockquote p { margin: 0; color: inherit; }

/* Links */
.editorial-content a {
    color: #2E6DA4;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(46,109,164,0.3);
    font-weight: 500;
    transition: all 0.2s ease;
}
.editorial-content a:hover {
    text-decoration-color: #2E6DA4;
    background: rgba(46,109,164,0.05);
    padding: 0 2px;
    border-radius: 2px;
}

.editorial-content strong { font-weight: 700; color: #111827; }

/* Bullet list */
.editorial-content ul { list-style: none; padding-left: 0; margin-bottom: 1.75rem; }
.editorial-content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.625rem;
    color: #4B5563;
    line-height: 1.75;
}
.editorial-content ul li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.65em;
    width: 6px;
    height: 6px;
    background: #60A0D0;
    border-radius: 1px;
    transform: rotate(45deg);
}

/* Ordered list */
.editorial-content ol { padding-left: 0; margin-bottom: 1.75rem; counter-reset: item; list-style: none; }
.editorial-content ol li {
    counter-increment: item;
    position: relative;
    padding-left: 2.5rem;
    margin-bottom: 0.875rem;
    color: #4B5563;
    line-height: 1.75;
}
.editorial-content ol li::before {
    content: counter(item);
    position: absolute;
    left: 0;
    top: 0.2rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: #2E6DA4;
    background: rgba(46,109,164,0.08);
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

/* Images */
.editorial-content figure,
.editorial-content img { margin: 2.25rem 0 0.25rem; }
.editorial-content img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
    box-shadow: 0 6px 28px -8px rgba(0,0,0,0.14);
}
.editorial-content figure figcaption,
.editorial-content [data-sanity-caption] {
    font-size: 0.8125rem;
    color: #9CA3AF;
    text-align: center;
    font-style: italic;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    padding: 0 0.75rem;
    line-height: 1.5;
}

/* Table */
.editorial-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.875rem;
}
@media (min-width: 768px) { .editorial-content table { font-size: 0.9375rem; } }
.editorial-content thead { background: #2E6DA4; color: white; }
.editorial-content thead th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.editorial-content tbody tr { border-bottom: 1px solid #F3F4F6; transition: background 0.15s; }
.editorial-content tbody tr:hover { background: rgba(46,109,164,0.02); }
.editorial-content tbody tr:nth-child(even) { background: #FAFAF9; }
.editorial-content td { padding: 0.75rem 1rem; color: #4B5563; vertical-align: top; }

/* HR */
.editorial-content hr {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, #E5E7EB 20%, #E5E7EB 80%, transparent 100%);
    margin: 3rem 0;
}

</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

    /* ── Reading progress ── */
    const progressBar    = document.getElementById('readingProgress');
    const sidebarProg    = document.getElementById('sidebarProgress');
    const sidebarProgPct = document.getElementById('sidebarProgressPct');
    const articleBody    = document.getElementById('articleBody');

    const updateProgress = () => {
        if (!articleBody || !progressBar) return;
        const rect     = articleBody.getBoundingClientRect();
        const total    = articleBody.offsetHeight - window.innerHeight;
        const scrolled = Math.max(0, -rect.top);
        const pct      = total > 0 ? Math.min(100, Math.round((scrolled / total) * 100)) : 0;
        progressBar.style.width = pct + '%';
        if (sidebarProg)    sidebarProg.style.width = pct + '%';
        if (sidebarProgPct) sidebarProgPct.textContent = pct + '%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    /* ── Scroll-to-top: reveal after 300px ── */
    const scrollTopBtn = document.getElementById('scrollTop');
    if (scrollTopBtn) {
        window.addEventListener('scroll', () => {
            const show = window.scrollY > 300;
            scrollTopBtn.style.opacity   = show ? '1' : '0';
            scrollTopBtn.style.transform = show ? 'translateY(0)' : 'translateY(8px)';
        }, { passive: true });
        scrollTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    /* ── Share buttons ── */
    const url   = encodeURIComponent(window.location.href);
    const title = encodeURIComponent(document.title);

    const setHref = (id, href) => {
        const el = document.getElementById(id);
        if (el) el.href = href;
    };
    setHref('shareWa',       `https://wa.me/?text=${title}%20${url}`);
    setHref('shareFb',       `https://www.facebook.com/sharer/sharer.php?u=${url}`);
    setHref('shareX',        `https://x.com/intent/tweet?text=${title}&url=${url}`);
    setHref('shareWaMobile', `https://wa.me/?text=${title}%20${url}`);
    setHref('shareFbMobile', `https://www.facebook.com/sharer/sharer.php?u=${url}`);
    setHref('shareXMobile',  `https://x.com/intent/tweet?text=${title}&url=${url}`);

    /* ── Copy link + toast ── */
    const toast = document.getElementById('copyToast');
    const showToast = () => {
        if (!toast) return;
        toast.style.opacity   = '1';
        toast.style.transform = 'translateX(-50%) translateY(0)';
        setTimeout(() => {
            toast.style.opacity   = '0';
            toast.style.transform = 'translateX(-50%) translateY(12px)';
        }, 2600);
    };
    const doCopy = () => {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href).then(showToast);
        } else {
            const ta = document.createElement('textarea');
            ta.value = window.location.href;
            Object.assign(ta.style, { position: 'fixed', opacity: '0' });
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showToast();
        }
    };
    document.getElementById('copyLink')?.addEventListener('click', doCopy);
    document.getElementById('copyLinkMobile')?.addEventListener('click', doCopy);

});
</script>
