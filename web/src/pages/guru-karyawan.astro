---
import BaseLayout from '../layouts/BaseLayout.astro'
import {urlFor} from '../lib/sanity/image'
import {getGuruKaryawanPage, getStaffMembers} from '../lib/sanity/queries'

const pageData = await getGuruKaryawanPage()
const staff = await getStaffMembers()

// 1. Pimpinan
const pimpinan = staff.filter((s: any) => s.group === 'pimpinan')

// 2. Guru Mapel (Menggabungkan semua kategori guru yang ada di Sanity)
const guruMapel = staff.filter((s: any) => ['cambridge', 'ict', 'tahfidz', 'guru'].includes(s.group))

// 3. Tenaga Kependidikan
const kependidikan = staff.filter((s: any) => s.group === 'kependidikan')

// Menyusun seksi yang akan di-render di bawah pimpinan
const sections = [
  {title: 'Guru Mata Pelajaran', items: guruMapel, accent: 'bg-blue-50 text-abbs-blue-dark'},
  {title: 'Tenaga Kependidikan', items: kependidikan, accent: 'bg-gray-100 text-gray-600'},
]
---
<BaseLayout title={pageData?.title || 'Guru & Karyawan'} description={pageData?.description}>
  <main class="pt-24 lg:pt-32 pb-20">
    
    <!-- Header Halaman -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-14">
      {pageData?.eyebrow && <div class="inline-flex items-center gap-2 text-abbs-blue-dark font-semibold mb-3 uppercase tracking-wider text-sm justify-center">{pageData.eyebrow}</div>}
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-gray-900 leading-tight mb-6">{pageData?.title}</h1>
      {pageData?.description && <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">{pageData.description}</p>}
    </div>

    <!-- Seksi 1: Pimpinan (Tampil Beda / Highlight) -->
    {pimpinan.length > 0 && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        {pimpinan.map((p: any) => (
          <div class="bg-white rounded-[2rem] shadow-xl border border-gray-100 overflow-hidden grid md:grid-cols-3 mb-8 last:mb-0 hover:shadow-2xl transition-shadow duration-300">
            <div class="h-64 md:h-auto overflow-hidden">
              {p.photo && (
                <img 
                  src={urlFor(p.photo).width(600).height(700).fit('crop').auto('format').url()} 
                  alt={p.name} 
                  class="w-full h-full object-cover" 
                />
              )}
            </div>
            <div class="md:col-span-2 p-8 md:p-10 flex flex-col justify-center">
              <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-abbs-blue-dark text-xs font-bold uppercase tracking-wider mb-4 w-fit border border-blue-100">
                {p.position}
              </span>
              <h2 class="font-display text-2xl md:text-3xl font-semibold text-gray-900 mb-3">{p.name}</h2>
              {p.bio && <p class="text-gray-600 leading-relaxed mb-6">{p.bio}</p>}
              {p.email && (
                <a href={`mailto:${p.email}`} class="text-sm text-abbs-blue-dark font-semibold hover:text-abbs-maroon transition-colors flex items-center gap-2 w-fit bg-gray-50 px-4 py-2 rounded-lg border border-gray-100">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  {p.email}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Seksi 2 & 3: Guru Mapel & Tenaga Kependidikan (Grid Style) -->
    {sections.filter((s) => s.items.length > 0).map((section) => (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${section.accent}`}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-semibold text-gray-900">{section.title}</h2>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {section.items.map((member: any) => (
            <div class="bg-white rounded-3xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full">
              <div class="h-60 overflow-hidden shrink-0">
                {member.photo ? (
                  <img 
                    src={urlFor(member.photo).width(400).height(400).fit('crop').auto('format').url()} 
                    alt={member.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  />
                ) : (
                  <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                    <svg class="w-12 h-12 text-gray-300" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="font-bold text-gray-900 text-lg mb-1">{member.name}</h3>
                <p class="text-sm text-abbs-blue-dark font-semibold mb-3">{member.position}</p>
                {member.bio && <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">{member.bio}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- CTA Section -->
    {pageData?.ctaTitle && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <div class="bg-gray-900 rounded-[2.5rem] p-10 md:p-16 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-abbs-blue rounded-full blur-[80px] opacity-20 -mr-20 -mt-20"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-abbs-maroon rounded-full blur-[80px] opacity-20 -ml-20 -mb-20"></div>
          
          <div class="relative z-10">
            <h2 class="font-display text-3xl md:text-4xl font-semibold text-white mb-4">{pageData.ctaTitle}</h2>
            {pageData.ctaDescription && <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8 leading-relaxed">{pageData.ctaDescription}</p>}
            {pageData.ctaButtonUrl && (
              <a href={pageData.ctaButtonUrl} target="_blank" rel="noopener" class="inline-flex bg-abbs-blue hover:bg-abbs-blue-dark text-white px-8 py-3.5 rounded-full font-bold transition-all shadow-lg hover:-translate-y-1">
                {pageData.ctaButtonLabel}
              </a>
            )}
          </div>
        </div>
      </div>
    )}
  </main>
</BaseLayout>