---
import BaseLayout from '../layouts/BaseLayout.astro'
import {urlFor} from '../lib/sanity/image'
import {getGuruKaryawanPage, getStaffMembers} from '../lib/sanity/queries'

const pageData = await getGuruKaryawanPage()
const staff = await getStaffMembers()

// 1. Pimpinan
const pimpinan = staff.filter((s: any) => s.group === 'pimpinan')

// 2. Guru Mapel (Menggabungkan semua kategori guru)
const guruMapel = staff.filter((s: any) => ['cambridge', 'ict', 'tahfidz', 'guru'].includes(s.group))

// 3. Tenaga Kependidikan
const kependidikan = staff.filter((s: any) => s.group === 'kependidikan')

// Menyusun seksi yang akan di-render
const sections = [
  {title: 'Guru Mata Pelajaran', items: guruMapel, accent: 'bg-blue-50 text-abbs-blue-dark', borderHover: 'group-hover:border-blue-200'},
  {title: 'Tenaga Kependidikan', items: kependidikan, accent: 'bg-gray-100 text-gray-600', borderHover: 'group-hover:border-gray-300'},
]
---
<BaseLayout title={pageData?.title || 'Guru & Karyawan'} description={pageData?.description}>
  <main class="pt-24 lg:pt-32 pb-20 bg-gray-50/50">
    
    <!-- Header Halaman -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      {pageData?.eyebrow && (
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 text-abbs-blue-dark font-bold mb-6 uppercase tracking-wider text-xs shadow-sm border border-blue-100">
          {pageData.eyebrow}
        </div>
      )}
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-gray-900 leading-tight mb-6">{pageData?.title}</h1>
      {pageData?.description && <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">{pageData.description}</p>}
    </div>

    <!-- Seksi 1: Pimpinan (Highlight Horizontal Card) -->
    {pimpinan.length > 0 && (
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
        {pimpinan.map((p: any) => (
          <div class="bg-white rounded-[2.5rem] shadow-xl border border-gray-100 p-6 md:p-10 flex flex-col md:flex-row items-center gap-8 md:gap-12 mb-8 last:mb-0 hover:shadow-2xl transition-shadow duration-300">
            
            {/* Foto Pimpinan dengan frame dekoratif */}
            <div class="shrink-0 relative group">
              <div class="absolute inset-0 bg-blue-100 rounded-[2rem] transform rotate-3 scale-105 -z-10 transition-transform group-hover:rotate-6"></div>
              <div class="w-48 h-48 md:w-56 md:h-56 rounded-[2rem] overflow-hidden border-4 border-white shadow-md bg-gray-100">
                {p.photo ? (
                  <img 
                    src={urlFor(p.photo).width(500).height(500).fit('crop').auto('format').url()} 
                    alt={p.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <svg class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                  </div>
                )}
              </div>
            </div>

            {/* Konten Teks Pimpinan */}
            <div class="flex flex-col flex-grow text-center md:text-left">
              <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-abbs-blue-dark text-xs font-bold uppercase tracking-wider mb-4 w-fit mx-auto md:mx-0 border border-blue-100">
                {p.position}
              </span>
              <h2 class="font-display text-3xl md:text-4xl font-semibold text-gray-900 mb-4">{p.name}</h2>
              {p.bio && <p class="text-gray-600 leading-relaxed mb-6 text-lg">{p.bio}</p>}
              
              {p.email && (
                <a href={`mailto:${p.email}`} class="text-sm text-gray-600 font-medium hover:text-abbs-blue-dark transition-colors flex items-center gap-2 w-fit mx-auto md:mx-0 px-5 py-2.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-abbs-blue-dark">
                  <svg class="w-5 h-5 text-abbs-blue-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  {p.email}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Seksi 2 & 3: Guru Mapel & Tenaga Kependidikan (ID Card Grid) -->
    {sections.filter((s) => s.items.length > 0).map((section) => (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
        <div class="flex flex-col items-center text-center mb-10">
          <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-4 ${section.accent}`}>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-semibold text-gray-900">{section.title}</h2>
          <div class="w-12 h-1 bg-gray-200 rounded-full mt-4"></div>
        </div>
        
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8">
          {section.items.map((member: any) => (
            <div class="bg-white rounded-3xl p-6 lg:p-8 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center flex flex-col h-full group">
              
              {/* Foto Bulat (Circle Avatar) */}
              <div class={`w-28 h-28 mx-auto mb-5 rounded-full overflow-hidden border-4 border-gray-50 shadow-sm bg-gray-100 transition-colors duration-300 ${section.borderHover}`}>
                {member.photo ? (
                  <img 
                    src={urlFor(member.photo).width(300).height(300).fit('crop').auto('format').url()} 
                    alt={member.name} 
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                  </div>
                )}
              </div>
              
              {/* Teks ID Card */}
              <div class="flex flex-col flex-grow">
                <h3 class="font-bold text-gray-900 text-lg mb-1 leading-tight">{member.name}</h3>
                <p class="text-sm text-abbs-blue-dark font-bold mb-3 uppercase tracking-wide">{member.position}</p>
                {member.bio && <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 mt-auto">{member.bio}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- CTA Section -->
    {pageData?.ctaTitle && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
        <div class="bg-gray-900 rounded-[2.5rem] p-10 md:p-16 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-abbs-blue rounded-full blur-[80px] opacity-20 -mr-20 -mt-20 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-abbs-maroon rounded-full blur-[80px] opacity-20 -ml-20 -mb-20 pointer-events-none"></div>
          
          <div class="relative z-10">
            <h2 class="font-display text-3xl md:text-4xl font-semibold text-white mb-4">{pageData.ctaTitle}</h2>
            {pageData.ctaDescription && <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8 leading-relaxed">{pageData.ctaDescription}</p>}
            {pageData.ctaButtonUrl && (
              <a href={pageData.ctaButtonUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-abbs-blue hover:bg-abbs-blue-dark text-white px-8 py-3.5 rounded-full font-bold transition-all shadow-lg hover:-translate-y-1">
                {pageData.ctaButtonLabel}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    )}
  </main>
</BaseLayout>